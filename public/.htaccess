# ============================================================
#  نماد نیرو — تنظیمات سرور (Apache)
#  این فایل همراه بقیهٔ فایل‌ها در ریشهٔ هاست آپلود می‌شود.
# ============================================================

Options -Indexes
DirectoryIndex index.html index.php

# ------------------------------------------------------------
#  ۱) آدرس یکتا: HTTPS و بدون www
#     (دامنهٔ متعارف در astro.config.mjs هم https://namadniroo.ir است)
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # اجبار به HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # www → بدون www
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # --------------------------------------------------------
    #  ۲) آدرس بدون پسوند → نسخهٔ .html
    #     آدرس‌های قدیمی وردپرس مثل /shop یا /about بدون پسوند
    #     بودند؛ این قانون آن‌ها را با ۳۰۱ به نسخهٔ جدید می‌برد.
    # --------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+?)/?$ /$1.html [R=301,L]
</IfModule>

# ------------------------------------------------------------
#  ۳) ریدایرکت آدرس‌های قدیمی وردپرس / ووکامرس
#     هدف: هیچ لینک ایندکس‌شده‌ای به ۴۰۴ نخورد.
# ------------------------------------------------------------
<IfModule mod_alias.c>
    # صفحات ثابت قدیمی
    Redirect 301 /contact-us       /contact.html
    Redirect 301 /about-us         /about.html

    # بخش‌های ووکامرس که در سایت جدید معادل ندارند
    Redirect 301 /cart             /shop.html
    Redirect 301 /checkout         /shop.html
    Redirect 301 /my-account       /contact.html
    Redirect 301 /wishlist         /shop.html
</IfModule>

<IfModule mod_rewrite.c>
    # صفحات تکی محصولات ووکامرس (/product/<اسلاگ-فارسی>/)
    # تا وقتی نگاشت تک‌به‌تک آماده نشده، همه به فهرست فروشگاه می‌روند
    # که از ۴۰۴ به‌مراتب بهتر است.
    RewriteRule ^product/.+ /shop.html [R=301,L]
    RewriteRule ^product-category/.+ /shop.html [R=301,L]
    RewriteRule ^product-tag/.+ /shop.html [R=301,L]

    # آرشیوها و فیدهای وردپرس
    RewriteRule ^(19|20)[0-9]{2}/.* /magazine.html [R=301,L]
    RewriteRule ^category/.+ /magazine.html [R=301,L]
    RewriteRule ^tag/.+ /magazine.html [R=301,L]
    RewriteRule ^author/.+ /about.html [R=301,L]
    RewriteRule ^(.*/)?feed/?$ /magazine.html [R=301,L]
</IfModule>

# ------------------------------------------------------------
#  ۴) صفحهٔ ۴۰۴ اختصاصی
# ------------------------------------------------------------
ErrorDocument 404 /404.html

# ------------------------------------------------------------
#  ۵) فشرده‌سازی (سرعت بارگذاری = فاکتور رتبه‌بندی)
# ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------
#  ۶) کش مرورگر
# ------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    # فایل‌های ساخته‌شده با هش در نام → کش طولانی
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    # تصاویر
    ExpiresByType image/jpeg                "access plus 6 months"
    ExpiresByType image/png                 "access plus 6 months"
    ExpiresByType image/webp                "access plus 6 months"
    ExpiresByType image/svg+xml             "access plus 6 months"
    # HTML کوتاه، چون با هر انتشار عوض می‌شود
    ExpiresByType text/html                 "access plus 10 minutes"
</IfModule>

# ------------------------------------------------------------
#  ۷) هدرهای امنیتی
# ------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(woff2?|css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------
#  ۸) جلوگیری از دسترسی به فایل‌های حساس
# ------------------------------------------------------------
<FilesMatch "\.(sqlite|db|log|ini|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
