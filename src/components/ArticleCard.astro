---
import { categoryLabel } from '../data/site';
import { fa } from '../utils';
import type { ArticleView } from '../server/repos/content';

interface Props { a: ArticleView }
const { a } = Astro.props;
---
<a class="mag-card" data-cat={a.category} href={`/magazine/${a.slug}`}>
  <span class="mag-tag">{categoryLabel[a.category]}</span>
  <h3 class="mag-title">{a.title}</h3>
  <span class="mag-date">{a.dateFa} · {fa(a.readTime)} دقیقه</span>
</a>
