---
interface Props { p: any; large?: boolean }
const { p, large = false } = Astro.props;
---
<article class:list={['proj-card', large && 'proj-lg']}>
  <div class="proj-img" style={p.image ? `--img:url('${p.image}')` : undefined}></div>
  <div class="proj-meta">
    <span class="proj-cap">{p.capacity} مگاوات · {p.tag}</span>
    <h3 class="proj-name">{p.name}</h3>
  </div>
</article>
