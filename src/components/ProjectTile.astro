---
import DbImage from './DbImage.astro';
import type { ProjectView } from '../server/repos/content';

interface Props { p: ProjectView; large?: boolean }
const { p, large = false } = Astro.props;

/* تصویر پروژه تگ img است نه background در CSS. با background — هرچند کارت
   پایین صفحه بود و دیده نمی‌شد — مرورگر بی‌درنگ دانلودش می‌کرد؛ حالا تا
   کاربر به آن نرسد بارگذاری نمی‌شود. */
const sizes = large ? '(max-width: 900px) 92vw, 640px' : '(max-width: 900px) 92vw, 420px';
---
<article class:list={['proj-card', large && 'proj-lg']}>
  <div class="proj-img">
    {p.image && <DbImage image={p.image} sizes={sizes} decorative />}
  </div>
  <div class="proj-meta">
    <span class="proj-cap">{p.capacity} مگاوات · {p.tag}</span>
    <h3 class="proj-name">{p.name}</h3>
  </div>
</article>
