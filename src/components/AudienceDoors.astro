---
import Icon from './Icon.astro';
import DbImage from './DbImage.astro';
import type { ImageRef } from '../server/repos/content';
import type { homePage } from '../data/pages';

/* «از کجا شروع کنیم؟» — هر بازدیدکننده در خودش را انتخاب می‌کند.
   در صنعت، مسیر مستقیم فرم مشاوره است (با نوع مشتری از پیش انتخاب‌شده)؛
   href برای وقتی است که جاوااسکریپت نباشد. */
interface Props { images: (ImageRef | null)[]; c: (typeof homePage.defaults)['doors'] }
const { images, c } = Astro.props;
---
<section class="doors" aria-labelledby="doors-title">
  <div class="wrap">
    <h2 id="doors-title" class="section-title doors-title">{c.title}</h2>
    <ul class="doors-list" role="list">
      {c.items.map((a, i) => {
        const img = images[i];
        const opensForm = a.who === 'industry';
        return (
          <li>
            <a
              class="door"
              href={opensForm ? '/contact' : a.href}
              data-quote={opensForm ? '' : undefined}
              data-who={opensForm ? a.who : undefined}
            >
              <span class="door-media">
                {img && <DbImage image={img} sizes="(max-width: 767px) 96px, 33vw" decorative />}
              </span>
              <span class="door-body">
                <span class="door-title">{a.title}</span>
                <span class="door-desc">{a.desc}</span>
                <span class="door-cta">
                  {a.cta}
                  <Icon name="arrowNext" />
                </span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
