---
import Base from '../layouts/Base.astro';
import RelatedArticles from './RelatedArticles.astro';
import ProductCard from './ProductCard.astro';
import DbImage from './DbImage.astro';
import { categoryLabel } from '../data/site';
import { breadcrumbSchema, fa } from '../utils';
import { aeModelForShop } from '../data/aesolarModels';
import { complementProducts, primaryFacet, productCrumbs, productsOfFacet, tagsOf } from '../data/shopTaxonomy';

import type { ProductView } from '../server/repos/content';

interface Props { p: ProductView; all: ProductView[] }
const { p, all } = Astro.props;

/* مقاله‌های آموزشی مرتبط با نوع محصول، برای لینک‌سازی داخلی */
const guides: Record<typeof p.kind, string[]> = {
  inverter: ['inverter-role', 'ongrid-offgrid', 'performance-ratio'],
  panel: ['how-panel-works', 'panel-washing', 'plant-components'],
  storage: ['ongrid-offgrid', 'inverter-role', 'solar-vs-generator'],
  accessory: ['plant-components', 'maintenance-kpi', 'om-plant'],
};

/* پنل AE Solar صفحهٔ مشخصات کامل هم دارد؛ این دو باید به هم پیوند بدهند */
const aeModel = aeModelForShop(p.slug);

/* مسیر راهنما به صفحه‌های ایندکس‌شدنی (نوع و نیت)، نه به فیلتر فروشگاه */
const crumbs = productCrumbs(p, all);
/* برچسب‌ها: هر بُعد به صفحهٔ خودش، یا به فیلتر noindex اگر صفحه ندارد */
const tags = tagsOf(p, all);
/* «در همین دسته» = هم‌خانواده‌ها در دقیق‌ترین صفحهٔ نیت محصول */
const facet = primaryFacet(p, all);
const related = (facet ? productsOfFacet(facet, all) : all.filter((x) => x.kind === p.kind))
  .filter((x) => x.slug !== p.slug)
  .slice(0, 4);
const relatedHref = crumbs[crumbs.length - 1]!;
/* فرزندان مکمل: کاروسل «معمولاً همراه این محصول» */
const complements = complementProducts(p, all, 8);

// نام برند بدون &nbsp; که در بعضی رکوردها برای جلوگیری از شکست خط آمده
const brandPlain = p.brand.replace(/&nbsp;/g, ' ').trim();

/* عنوان پیش‌فرض: نام محصول در دیتابیس برند ندارد («پنل دوطرفه CME»)، ولی
   مردم با برند جست‌وجو می‌کنند («پنل AE Solar»). خط‌تیرهٔ نشکن (U+2011) هم
   که برای جلوگیری از شکست خط در نام آمده، مدل را برای موتور جست‌وجو یک
   کلمهٔ ناآشنا می‌کند؛ در عنوان به خط‌تیرهٔ معمولی برمی‌گردد. */
const title = p.seoTitle || `${p.name.replace(/\u2011/g, '-')} | ${brandPlain} — فروشگاه نماد نیرو`;
const description =
  p.seoDescription ||
  `${p.name} — ${brandPlain} — ${p.spec} ${p.specUnit}. استعلام قیمت، موجودی و مشاوره فنی از نماد نیرو.`;

const pageSchema = [
  breadcrumbSchema([...crumbs, { name: p.name, href: `/shop/${p.slug}` }]),
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    description,
    brand: { '@type': 'Brand', name: brandPlain },
    category: categoryLabel[p.cat],
    ...(p.image ? { image: new URL(p.image.url, 'https://namadniroo.ir').href } : {}),
    /* فروشگاه لیدجن است و قیمت آنلاین ندارد، پس `Offer` نمی‌آید: Offer بدون
       قیمت را گوگل نمی‌پذیرد، و قبلاً با price: '0' به گوگل گفته می‌شد
       قیمت هر محصول صفر ریال است — درست در جست‌وجوی «قیمت پنل …». */
  },
];
---
<Base
  title={title}
  description={description}
  image={p.image?.url}
  type="product"
  schema={pageSchema}
  noindex={p.noindex}
  canonical={p.canonicalOverride}
>
  <div class="article-head">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="مسیر صفحه">
        <a href="/">خانه</a>
        {crumbs.map((c) => (<><span>/</span><a href={c.href}>{c.name}</a></>))}
      </nav>
      <span class="mag-tag">{categoryLabel[p.cat]}</span>
      <h1 class="article-title">{p.name}</h1>
      <p class="article-meta" dir="ltr">{brandPlain} · {p.spec} {p.specUnit}</p>
    </div>
  </div>

  <section class="about-sec">
    <div class="wrap about-intro">
      <div class="product-thumb product-hero">
        {p.image
          ? <DbImage image={p.image} class="product-img" sizes="(max-width: 800px) 90vw, 620px" priority />
          : <span class="thumb-brand" set:html={p.brand} />}
      </div>
      <div>
        <p class="lead-lg">{brandPlain} · {p.spec} {p.specUnit}</p>
        {p.body
          ? <p>{p.body}</p>
          : (
            <p>
              محصولی از دستهٔ محصولات {categoryLabel[p.cat]} نماد نیرو، مناسب برای پروژه‌های
              {p.cat === 'home' ? ' خانگی و تجاری کوچک' : ' صنعتی و نیروگاهی'}.
              مشخصات فنی کامل، قیمت روز، موجودی و زمان تحویل را از کارشناسان فروش استعلام بگیرید.
            </p>
          )}
        <a class="btn btn-solid" href="/#quote">استعلام قیمت و موجودی</a>
        <ul class="p-tags" aria-label="برچسب‌های محصول">
          {tags.map((t) => (
            <li><span>{t.dim}</span><a href={t.href} rel={t.indexable ? undefined : 'nofollow'}>{t.label}</a></li>
          ))}
        </ul>
        {aeModel && (
          <p><a href={`/ae-solar/${aeModel.slug}`}>مشخصات کامل و دیتاشیت پنل {fa(aeModel.maxW)} وات AE Solar {aeModel.series} ←</a></p>
        )}
      </div>
    </div>
  </section>

  {complements.length > 0 && (
    <section class="shop-comp">
      <div class="wrap">
        <header class="section-head">
          <p class="eyebrow">معمولاً همراه این محصول</p>
          <h2 class="section-title">کالاهایی که کنار {p.name} لازم می‌شود</h2>
        </header>
        <div class="comp-rail">
          {complements.map((r) => <ProductCard p={r} />)}
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="shop">
      <div class="wrap">
        <header class="section-head">
          <p class="eyebrow">در همین دسته</p>
          <h2 class="section-title"><a href={relatedHref.href}>{relatedHref.name}</a></h2>
        </header>
        <div class="products">
          {related.map((r) => <ProductCard p={r} />)}
        </div>
      </div>
    </section>
  )}

  <RelatedArticles slugs={guides[p.kind]} title="راهنمای خرید و بهره‌برداری" />

  <section class="cta-band">
    <div class="wrap">
      <h2>دربارهٔ این محصول سؤال دارید؟</h2>
      <p>کارشناسان ما مشخصات فنی، قیمت و زمان تحویل را برایتان مشخص می‌کنند.</p>
      <a class="btn btn-solid" href="/#quote">درخواست مشاوره</a>
    </div>
  </section>
</Base>

<style>
  .p-tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0 0; padding: 0; list-style: none; }
  .p-tags li { display: inline-flex; align-items: center; border: 1px solid var(--line-2); border-radius: 999px; overflow: hidden; font-size: 13.5px; }
  .p-tags span { padding: 5px 10px; background: var(--bg-2); color: var(--faint); }
  .p-tags a { padding: 5px 12px; color: var(--muted); }
  .p-tags a:hover { color: var(--yellow); }
  .section-title a { color: inherit; }
  .section-title a:hover { color: var(--yellow); }
  .shop-comp { padding: 56px 0; background: var(--bg-1); border-block: 1px solid var(--line); }
  .comp-rail { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(240px, 280px); gap: 18px; overflow-x: auto; padding-bottom: 10px; scroll-snap-type: x mandatory; }
  .comp-rail > :global(*) { scroll-snap-align: start; }
</style>
