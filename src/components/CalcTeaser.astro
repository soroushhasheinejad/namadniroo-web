---
import { YIELD_BY_REGION } from '../data/solarModel';
import type { homePage } from '../data/pages';

interface Props { c: (typeof homePage.defaults)['calcTeaser'] }
const { c } = Astro.props;

/* دو سؤال اول ماشین‌حساب، داخل صفحهٔ اصلی.
   شروع با سؤالی که جوابش آسان است («چقدر سرمایه؟») بازدیدکننده را وارد
   مسیر می‌کند؛ بقیهٔ فرض‌ها در خود صفحهٔ ماشین‌حساب است. فرم یک GET
   ساده است، پس بدون جاوااسکریپت هم کار می‌کند. */
const budgets = [
  { value: 1_000_000_000, label: '۱ میلیارد' },
  { value: 5_000_000_000, label: '۵ میلیارد' },
  { value: 10_000_000_000, label: '۱۰ میلیارد' },
  { value: 70_000_000_000, label: '۷۰ میلیارد' },
];
const regions = Object.entries(YIELD_BY_REGION);
---
<section class="calc-teaser" aria-labelledby="calc-teaser-title">
  <div class="wrap calc-teaser-inner">
    <div class="calc-teaser-copy">
      <h2 id="calc-teaser-title" class="section-title">{c.title}</h2>
      {c.text && <p>{c.text}</p>}
    </div>

    <form class="calc-teaser-form" action="/solar-calculator" method="get">
      <fieldset class="ct-group">
        <legend>سرمایهٔ موردنظر (تومان)</legend>
        <div class="ct-pills">
          {budgets.map((b, i) => (
            <label class="ct-pill">
              <input type="radio" name="amount" value={b.value} checked={i === 2} />
              <span>{b.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="ct-group">
        <label for="ct-region" class="ct-label">محل نیروگاه</label>
        <select id="ct-region" name="region" class="ct-select">
          {regions.map(([key, r]) => (
            <option value={key} selected={key === 'high'}>{r.label}</option>
          ))}
        </select>
      </div>

      <button type="submit" class="btn btn-solid btn-block">{c.button}</button>
    </form>
  </div>
</section>
