---
import DbImage from './DbImage.astro';
import { categoryLabel } from '../data/site';
import type { ProductView } from '../server/repos/content';

interface Props { p: ProductView; showCat?: boolean }
const { p, showCat = true } = Astro.props;
---
<article class="product-card" data-cat={p.cat}>
  <div class="product-thumb">
    {showCat && <span class="product-cat">{categoryLabel[p.cat]}</span>}
    {p.image
      ? <DbImage image={p.image} class="product-img" sizes="(max-width: 700px) 45vw, 300px" />
      : <span class="thumb-brand" set:html={p.brand} />}
  </div>
  <div class="product-body">
    <h3 class="product-name">{p.name}</h3>
    <p class="product-spec"><b>{p.spec}</b> {p.specUnit}</p>
    <div class="product-foot"><a class="product-link" href={`/shop/${p.slug}`}>مشاهدهٔ محصول ←</a></div>
  </div>
</article>
