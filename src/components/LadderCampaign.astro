---
/**
 * بلوک کمپین «تخفیف پله‌ای» بالای فروشگاه — نسخهٔ ساده.
 *
 * فقط درصد تخفیف نشان داده می‌شود، نه قیمت. همهٔ عددها از تنظیمات
 * `ladder` در پنل می‌آیند (data/ladder.ts) و این بلوک هیچ عددی نمی‌سازد.
 * اسم مناسبت (بلک‌فرایدی) عمداً نمی‌آید. چالش و قانون‌ها پشت دو پیوند
 * آرام‌اند تا بلوک شلوغ نشود.
 */
import DbImage from './DbImage.astro';
import DevicePlate from './DevicePlate.astro';
import { BRANDS, brandKey } from '../data/shopTaxonomy';
import type { LadderView } from '../data/ladder';
import type { ProductView } from '../server/repos/content';

interface Props { view: LadderView; products: ProductView[]; demo?: boolean }
const { view, products, demo = false } = Astro.props;

const bySlug = new Map(products.map((p) => [p.slug, p]));
const rows = view.items
  .map((s) => ({ s, p: bySlug.get(s.slug) }))
  .filter((r): r is { s: typeof r.s; p: ProductView } => !!r.p);

const n = (v: number) => v.toLocaleString('fa-IR');
const brandOf = (p: ProductView) => BRANDS[brandKey(p.brand)] ?? p.brand.replace(/&nbsp;/g, ' ');
const endsIso = view.ends?.toISOString() ?? '';
---
<section class="lad" id="ladder" aria-labelledby="lad-title">
  <div class="wrap">
    {demo && <p class="lad-demo">دادهٔ نمونه برای دیدن طراحی؛ فقط در محیط توسعه.</p>}

    <header class="lad-head">
      <div>
        <h2 class="lad-title" id="lad-title">{view.title}</h2>
        <p class="lad-lead">{view.lead}</p>
      </div>
      {endsIso && <p class="lad-clock" data-ends={endsIso}></p>}
    </header>

    <div class="lad-grid">
      {rows.map(({ s, p }) => {
        const cur = s.current;
        const unit = p.specUnit.split('·')[0]?.trim() ?? '';
        const pct = cur ? Math.round((cur.soldInTier / cur.units) * 100) : 100;
        return (
          <article class="lad-card">
            <a class="lad-thumb" href={`/shop/${p.slug}`} tabindex="-1" aria-hidden="true">
              {p.image
                ? <DbImage image={p.image} class="lad-img" sizes="(max-width: 700px) 90vw, 360px" decorative />
                : <DevicePlate kind={p.kind} brand={brandOf(p)} spec={p.spec} unit={unit} />}
            </a>
            <div class="lad-body">
              <h3 class="lad-name"><a href={`/shop/${p.slug}`}>{p.name}</a></h3>
              {cur ? (
                <>
                  <p class="lad-off"><b>{n(cur.off)}٪</b> تخفیف</p>
                  <div class="lad-bar" aria-hidden="true"><i style={`width:${pct}%`}></i></div>
                  <p class="lad-note">
                    {n(s.remainingInCurrent)} دستگاه با این تخفیف مانده
                    {s.next && <> · تخفیف بعدی: {n(s.next.off)}٪</>}
                  </p>
                </>
              ) : (
                <p class="lad-note">تخفیف این مدل تمام شد.</p>
              )}
              <button type="button" class="lad-cta" data-quote data-who="buyer">دریافت پیش‌فاکتور</button>
            </div>
          </article>
        );
      })}
    </div>

    <div class="lad-more">
      {view.challengeQuestion && (
        <details class="lad-det">
          <summary>چالش امروز: یک جواب درست، یک پله تخفیف بیشتر</summary>
          <div class="lad-det-body">
            <p class="lad-q">{view.challengeQuestion}</p>
            {view.challengeDeadline && <p class="lad-small">مهلت جواب: {view.challengeDeadline}. همهٔ جواب‌های درست برنده‌اند.</p>}
            <form class="lad-form" data-quiz novalidate>
              <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp-field" aria-hidden="true" />
              <label class="lad-wide"><span>جواب</span><textarea name="answer" rows="2" required maxlength="300"></textarea></label>
              <label><span>نام شرکت یا نام شما</span><input name="name" type="text" autocomplete="organization" required /></label>
              <label><span>موبایل</span><input name="phone" type="tel" inputmode="tel" dir="ltr" autocomplete="tel" placeholder="09xx xxx xxxx" required /></label>
              <button type="submit" class="lad-cta">ثبت جواب</button>
              <p class="lad-msg" role="status" aria-live="polite"></p>
            </form>
          </div>
        </details>
      )}
      <details class="lad-det">
        <summary>قانون‌ها</summary>
        <ol class="lad-det-body lad-rules">{view.rules.map((r) => <li>{r}</li>)}</ol>
      </details>
    </div>
  </div>
</section>

<script>
  /* زمان باقی‌مانده تا پایان واقعی کمپین (از پنل)، در یک خط */
  const clock = document.querySelector<HTMLElement>('.lad-clock[data-ends]');
  if (clock) {
    const end = Date.parse(clock.dataset.ends!);
    const tick = () => {
      const left = Math.max(0, end - Date.now());
      const d = Math.floor(left / 864e5);
      const h = Math.floor((left % 864e5) / 36e5);
      const m = Math.floor((left % 36e5) / 6e4);
      const fa = (v: number) => v.toLocaleString('fa-IR');
      clock.textContent = left === 0
        ? 'کمپین تمام شد'
        : d > 0 ? `${fa(d)} روز و ${fa(h)} ساعت مانده` : `${fa(h)} ساعت و ${fa(m)} دقیقه مانده`;
      if (left > 0) setTimeout(tick, 30_000);
    };
    tick();
  }

  /* جواب چالش مثل یک درخواست عادی در پنل لیدها ثبت می‌شود، با منبع جدا */
  const form = document.querySelector<HTMLFormElement>('form[data-quiz]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = form.querySelector<HTMLElement>('.lad-msg')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const data = new FormData(form);
    const answer = String(data.get('answer') ?? '').trim();
    const name = String(data.get('name') ?? '').trim();
    const phone = String(data.get('phone') ?? '').trim();
    if (!answer || !name || !phone) { msg.textContent = 'جواب، نام و موبایل را بنویسید.'; return; }
    btn.disabled = true;
    msg.textContent = 'در حال ارسال…';
    const q = new URLSearchParams(location.search);
    try {
      const res = await fetch('/api/quote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name, phone, website: data.get('website'),
          source: 'ladder-challenge',
          estimate: `جواب چالش: ${answer}`.slice(0, 400),
          utm_source: q.get('utm_source') ?? undefined,
          utm_medium: q.get('utm_medium') ?? undefined,
          utm_campaign: q.get('utm_campaign') ?? 'ladder-azar1405',
        }),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok || !body.success) throw new Error(body.message || 'ارسال ناموفق بود');
      form.reset();
      msg.textContent = 'ثبت شد. اگر جواب درست باشد، کد تخفیف با پیامک می‌آید.';
    } catch (err) {
      msg.textContent = err instanceof Error ? err.message : 'ارسال ناموفق بود';
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .lad { padding: 64px 0 56px; background: var(--bg-1); border-block: 1px solid var(--line); }
  .lad-demo { margin: 0 0 24px; font-size: 12.5px; color: var(--faint); }

  .lad-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 32px; }
  .lad-title { margin: 0; font-size: clamp(24px, 3vw, 34px); font-weight: 800; line-height: 1.35; }
  .lad-lead { margin: 10px 0 0; max-width: 56ch; color: var(--muted); font-size: 16px; }
  .lad-clock { flex: none; margin: 0; font-size: 14px; color: var(--yellow); }

  .lad-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
  .lad-card { display: flex; flex-direction: column; background: var(--bg); border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; }
  .lad-thumb { position: relative; display: block; aspect-ratio: 4 / 3; background: #E9E8E4; }
  .lad-thumb :global(.lad-img) { position: absolute; inset: 10%; width: 80%; height: 80%; object-fit: contain; mix-blend-mode: multiply; }
  .lad-body { display: flex; flex-direction: column; flex: 1; padding: 20px; }
  .lad-name { margin: 0 0 14px; font-size: 16px; font-weight: 700; line-height: 1.55; }
  .lad-name a:hover { color: var(--yellow); }
  .lad-off { margin: 0 0 12px; font-size: 15px; color: var(--muted); }
  .lad-off b { font-size: 40px; font-weight: 800; line-height: 1; color: var(--yellow); margin-inline-end: 4px; }
  .lad-bar { height: 3px; background: var(--line-2); border-radius: 3px; overflow: hidden; }
  .lad-bar i { display: block; height: 100%; background: var(--yellow); }
  .lad-note { margin: 10px 0 0; font-size: 13px; color: var(--faint); }
  .lad-cta {
    align-self: flex-start; margin-top: 20px; min-height: 44px; padding: 0 20px; cursor: pointer;
    font-family: var(--font); font-size: 14px; font-weight: 700; color: #1A1400;
    background: var(--yellow); border: 0; border-radius: 999px; transition: background .2s;
  }
  .lad-cta:hover { background: var(--yellow-2); }
  .lad-cta:disabled { opacity: .6; cursor: progress; }

  .lad-more { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 28px; }
  .lad-det { flex: 1 1 100%; }
  .lad-det:not([open]) { flex: 0 1 auto; }
  .lad-det summary { cursor: pointer; list-style: none; font-size: 14px; color: var(--muted); }
  .lad-det summary::-webkit-details-marker { display: none; }
  .lad-det summary::after { content: ' ↓'; color: var(--faint); }
  .lad-det[open] summary::after { content: ' ↑'; }
  .lad-det summary:hover { color: var(--ink); }
  .lad-det-body { max-width: 720px; margin: 16px 0 8px; }
  .lad-q { margin: 0 0 6px; font-size: 16px; line-height: 1.8; }
  .lad-small { margin: 0 0 16px; font-size: 13px; color: var(--faint); }
  .lad-form { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .lad-form label { display: grid; gap: 4px; font-size: 12.5px; color: var(--faint); }
  .lad-wide { grid-column: 1 / -1; }
  .lad-form :is(input, textarea) {
    width: 100%; min-height: 44px; padding: 9px 12px; font: inherit; font-size: 15px; color: var(--ink);
    background: var(--bg); border: 1px solid var(--line-2); border-radius: 10px; resize: vertical;
  }
  .lad-form :is(input, textarea):focus { outline: none; border-color: var(--yellow); }
  .lad-form .lad-cta { margin-top: 0; }
  .lad-msg { grid-column: 1 / -1; margin: 0; min-height: 1.4em; font-size: 13px; color: var(--muted); }
  .lad-rules { padding-inline-start: 20px; display: grid; gap: 6px; font-size: 14px; color: var(--muted); }

  @media (max-width: 700px) {
    .lad { padding: 44px 0 40px; }
    .lad-head { flex-direction: column; align-items: flex-start; gap: 10px; }
    .lad-form { grid-template-columns: 1fr; }
    .lad-grid { gap: 14px; }
    /* روی موبایل کارت افقی می‌شود تا سه مدل در یک نگاه جا شوند */
    .lad-card { flex-direction: row; }
    .lad-thumb { flex: none; width: 36%; aspect-ratio: auto; }
    .lad-thumb :global(.plate-brand) { display: none; }
    .lad-body { padding: 14px; }
    .lad-name { margin-bottom: 8px; font-size: 14px; }
    .lad-off { margin-bottom: 8px; }
    .lad-off b { font-size: 30px; }
    .lad-note { font-size: 12px; }
    .lad-cta { margin-top: 12px; min-height: 40px; padding: 0 16px; font-size: 13px; }
  }
</style>
