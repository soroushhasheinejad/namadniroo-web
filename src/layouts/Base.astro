---
import '../styles/global.css';
import '../styles/conversion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteDialog from '../components/QuoteDialog.astro';
import MobileBar from '../components/MobileBar.astro';
import Analytics from '../components/Analytics.astro';
import { getSiteSettings } from '../server/repos/siteSettings';
import { getSeoSettings } from '../server/repos/seoSettings';
import { organizationSchema } from '../server/seo/structuredData';
import { mediaIndex, urlFrom } from '../server/media/resolve';

interface Props {
  title: string;
  description?: string;
  /** تصویر معرف صفحه هنگام اشتراک‌گذاری لینک (مسیر مطلق از ریشهٔ سایت) */
  image?: string;
  /** نوع صفحه برای Open Graph */
  type?: 'website' | 'article' | 'product';
  /** داده‌های ساختاریافتهٔ اضافی مخصوص این صفحه (JSON-LD) */
  schema?: Record<string, any> | Record<string, any>[];
  /** صفحه از نتایج موتور جست‌وجو کنار گذاشته شود */
  noindex?: boolean;
  /**
   * بزرگ‌ترین تصویر بالای صفحه، برای اعلام زودهنگام به مرورگر.
   * بدون این، مرورگر تصویر را فقط وقتی پیدا می‌کند که به تگ img در بدنه
   * برسد؛ با این، دانلود هم‌زمان با خواندن <head> شروع می‌شود.
   */
  preloadImage?: { src: string; srcset?: string; sizes?: string };
  /**
   * نشانی canonical دستی. فقط وقتی لازم است که همین محتوا در نشانی دیگری
   * هم هست و باید به گوگل گفت کدام اصلی است؛ در حالت عادی خودکار است.
   */
  canonical?: string | null;
}

const {
  title,
  description,
  image,
  type = 'website',
  schema,
  noindex = false,
  preloadImage,
  canonical: canonicalOverride,
} = Astro.props;

const SITE = Astro.site ?? 'https://namadniroo.ir';

const [{ site }, seo, index] = await Promise.all([
  getSiteSettings(),
  getSeoSettings(),
  mediaIndex().catch(() => new Map()),
]);

/* صفحه‌ای که توضیح یا تصویر خودش را ندارد، از پیش‌فرض‌های «تنظیمات سئو»
   استفاده می‌کند. */
const metaDescription = description || seo.defaults.description;
const shareImage = image || urlFrom(index, seo.defaults.image) || '/assets/og-default.jpg';

const canonical = new URL(canonicalOverride || Astro.url.pathname, SITE);
const ogImage = new URL(shareImage, SITE);

/* دادهٔ ساختاریافتهٔ سازمان در همهٔ صفحات، ساخته از «تنظیمات سئو ←
   اطلاعات کسب‌وکار». */
const schemas = [
  organizationSchema(seo.business, site.name),
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];

/* `<` داخل JSON به‌صورت \u003c نوشته می‌شود. بدون این، متنی مثل
   «</script>» در عنوان یک محصول یا نام شرکت، بلوک را زودتر می‌بست و بقیه‌اش
   به‌عنوان کد اجرا می‌شد. JSON معادل همان متن است، پس گوگل تفاوتی نمی‌بیند. */
const jsonLd = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');

const { webmaster } = seo;
---
<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{title}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonical.href} />
  {noindex
    ? <meta name="robots" content="noindex, nofollow" />
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

  <link rel="icon" href="/assets/logo.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/DanaVF.woff2" as="font" type="font/woff2" crossorigin />

  {preloadImage && (
    <link
      rel="preload"
      as="image"
      href={preloadImage.src}
      imagesrcset={preloadImage.srcset}
      imagesizes={preloadImage.sizes}
      fetchpriority="high"
    />
  )}

  {/* Open Graph — برای واتساپ، تلگرام، لینکدین و... */}
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content="fa_IR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonical.href} />
  <meta property="og:image" content={ogImage.href} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImage.href} />

  <meta name="theme-color" content="#0A0A0A" />

  {/* تأیید مالکیت در کنسول‌های جست‌وجو — از «تنظیمات سئو ← ابزار وبمستر» */}
  {webmaster.google && <meta name="google-site-verification" content={webmaster.google} />}
  {webmaster.bing && <meta name="msvalidate.01" content={webmaster.bing} />}
  {webmaster.yandex && <meta name="yandex-verification" content={webmaster.yandex} />}

  {/* شناسه‌ها پیش از ذخیره با الگوی دقیق بررسی می‌شوند، پس درج مستقیمشان امن است */}
  {webmaster.gtm && (
    <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${webmaster.gtm}');`} />
  )}
  {webmaster.ga4 && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${webmaster.ga4}`}></script>
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${webmaster.ga4}');`} />
    </>
  )}
  {/* کد دلخواه مدیر — عمداً بدون بررسی؛ فقط نقش «مدیر» می‌تواند ویرایشش کند */}
  {webmaster.customHead && <Fragment set:html={webmaster.customHead} />}

  <slot name="head" />

  {schemas.map((s) => (
    <script type="application/ld+json" set:html={jsonLd(s)} />
  ))}
</head>
<body id="top">
  {webmaster.gtm && (
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${webmaster.gtm}`}
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  )}
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <MobileBar />
  <QuoteDialog />
  <Analytics />

  <script>
    // منوی موبایل
    const btn = document.getElementById('menuToggle');
    const nav = document.querySelector('.nav');
    btn?.addEventListener('click', () => {
      const open = nav?.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    nav?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName === 'A') {
        nav.classList.remove('is-open');
        btn?.setAttribute('aria-expanded', 'false');
      }
    });
  </script>
</body>
</html>
