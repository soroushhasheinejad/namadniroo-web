---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import AudienceDoors from '../components/AudienceDoors.astro';
import Stats from '../components/Stats.astro';
import CalcTeaser from '../components/CalcTeaser.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import HomeFaq from '../components/HomeFaq.astro';
import DbImage from '../components/DbImage.astro';
import SectionHead from '../components/SectionHead.astro';
import ProductCard from '../components/ProductCard.astro';
import ProjectTile from '../components/ProjectTile.astro';
import ArticleCard from '../components/ArticleCard.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { listArticles, listFeaturedProducts, listFeaturedProjects } from '../server/repos/content';
import { promoSlides } from '../server/repos/slides';
import { homeImages } from '../server/repos/homeMedia';
import { buildSrcset } from '../server/media/store';
import { faqSchema } from '../utils';
import { getSeoSettings } from '../server/repos/seoSettings';
import { localBusinessSchema } from '../server/seo/structuredData';
import { seoProps } from '../server/seo/pageSeo';
import { getPageContent } from '../server/repos/pageContent';
import { homePage } from '../data/pages';


export const prerender = false;

/* سه بخش صفحه به هم وابسته نیستند، پس با هم خوانده می‌شوند نه پشت سر هم —
   وگرنه زمان رندر می‌شد مجموع سه کوئری به‌جای کندترینشان. */
const [products, projects, articles, promos, seoSettings, c] = await Promise.all([
  listFeaturedProducts(4),
  listFeaturedProjects(3),
  listArticles().then((all) => all.slice(0, 3)),
  promoSlides(),
  getSeoSettings(),
  // همهٔ متن و تصاویر صفحه، از «متن صفحات ← صفحهٔ اصلی»
  getPageContent(homePage),
]);
const [images, seo] = await Promise.all([homeImages(c), seoProps(c.seo)]);

/* عکس هیرو بزرگ‌ترین عنصر قابل مشاهدهٔ صفحه (LCP) است. آدرسش را به Base
   می‌دهیم تا در <head> با preload اعلام شود و دانلودش هم‌زمان با خواندن
   سرصفحه شروع شود، نه بعد از رسیدن به تگ img. `sizes` باید با همان
   مقدار خود تگ img یکی باشد، وگرنه مرورگر دو نسخه دانلود می‌کند. */
const lcp = images.hero;
const HERO_SIZES = '(max-width: 767px) 100vw, 50vw';

/* بنر فروشگاه دیگر در اسلایدر نمی‌چرخد؛ ثابت بالای محصولات می‌نشیند. */
const shopBanner = promos.find((p) => p.href === '/shop' && p.image) ?? null;

const homeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'نماد نیرو',
    url: 'https://namadniroo.ir',
    inLanguage: 'fa-IR',
    publisher: { '@id': 'https://namadniroo.ir/#organization' },
  },
  // از «تنظیمات سئو ← اطلاعات کسب‌وکار»
  localBusinessSchema(seoSettings.business),
  // همان پرسش‌هایی که روی صفحه است — گوگل ناهمخوانی این دو را جریمه می‌کند
  faqSchema(c.faq.items),
];

---
<Base {...seo}
  schema={homeSchema}
  preloadImage={lcp ? { src: lcp.url, srcset: buildSrcset(lcp.key, lcp.width), sizes: HERO_SIZES } : undefined}
>
  <HomeHero image={images.hero} c={c.hero} />
  <AudienceDoors images={images.doors} c={c.doors} />
  <Stats />
  <CalcTeaser c={c.calcTeaser} />

  <section class="projects">
    <div class="wrap">
      <SectionHead eyebrow={c.projects.eyebrow} title={c.projects.title} moreHref="/projects" moreLabel={c.projects.moreLabel} />
      <div class="proj-grid">
        {projects.map((p, i) => <ProjectTile p={p} large={i === 0} />)}
      </div>
      <div class="section-cta">
        <p>{c.projects.ctaText}</p>
        <a class="btn btn-ghost" href="/contact" data-quote data-who="industry">{c.projects.ctaLabel}</a>
      </div>
    </div>
  </section>

  <ProcessSteps c={c.process} />

  <section class="shop">
    <div class="wrap">
      <SectionHead eyebrow={c.shop.eyebrow} title={c.shop.title} moreHref="/shop" />
      {shopBanner?.image && (
        <a class="shop-banner" href="/shop" aria-label={shopBanner.alt}>
          <DbImage image={shopBanner.image} sizes="(max-width: 1240px) 100vw, 1192px" decorative />
        </a>
      )}
      <div class="products rail">
        {products.map((p) => <ProductCard p={p} showCat={false} />)}
      </div>
    </div>
  </section>

  <HomeFaq c={c.faq} />

  <section class="magazine">
    <div class="wrap">
      <SectionHead eyebrow={c.magazine.eyebrow} title={c.magazine.title} moreHref="/magazine" moreLabel={c.magazine.moreLabel} />
      <div class="mag-grid rail">
        {articles.map((a) => <ArticleCard a={a} />)}
      </div>
    </div>
  </section>

  <QuoteForm uid="home" />
</Base>
