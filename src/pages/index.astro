---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import Stats from '../components/Stats.astro';
import PromoSlider from '../components/PromoSlider.astro';
import SectionHead from '../components/SectionHead.astro';
import ProductCard from '../components/ProductCard.astro';
import ProjectTile from '../components/ProjectTile.astro';
import ArticleCard from '../components/ArticleCard.astro';
import QuoteForm from '../components/QuoteForm.astro';

const products = (await getCollection('products'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);
---
<Base title="نماد نیرو | راه‌کارهای جامع انرژی پایدار">
  <HeroSlider />
  <Stats />
  <PromoSlider />

  <section class="shop">
    <div class="wrap">
      <SectionHead eyebrow="فروشگاه تجهیزات" title="اینورترها و پنل‌های خورشیدی" moreHref="/shop.html" />
      <div class="products">
        {products.map((p) => <ProductCard p={p.data} id={p.id} showCat={false} />)}
      </div>
    </div>
  </section>

  <section class="projects">
    <div class="wrap">
      <SectionHead eyebrow="نمونه‌کارها" title="از کویر تا خط تولید" moreHref="/projects.html" moreLabel="همهٔ پروژه‌ها" />
      <div class="proj-grid">
        {projects.map((p, i) => <ProjectTile p={p.data} large={i === 0} />)}
      </div>
    </div>
  </section>

  <section class="magazine">
    <div class="wrap">
      <SectionHead eyebrow="مجلهٔ انرژی" title="دانش، بازار و اخبار" moreHref="/magazine.html" moreLabel="همهٔ مقاله‌ها" />
      <div class="mag-grid">
        {articles.map((a) => <ArticleCard a={a} />)}
      </div>
    </div>
  </section>

  <QuoteForm />
</Base>
