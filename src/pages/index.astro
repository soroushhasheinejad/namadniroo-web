---
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import Stats from '../components/Stats.astro';
import PromoSlider from '../components/PromoSlider.astro';
import SectionHead from '../components/SectionHead.astro';
import ProductCard from '../components/ProductCard.astro';
import ProjectTile from '../components/ProjectTile.astro';
import ArticleCard from '../components/ArticleCard.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { listArticles, listFeaturedProducts, listFeaturedProjects } from '../server/repos/content';
import { heroSlides } from '../server/repos/slides';
import { buildSrcset } from '../server/media/store';


export const prerender = false;

/* سه بخش صفحه به هم وابسته نیستند، پس با هم خوانده می‌شوند نه پشت سر هم —
   وگرنه زمان رندر می‌شد مجموع سه کوئری به‌جای کندترینشان. */
const [products, projects, articles, slides] = await Promise.all([
  listFeaturedProducts(4),
  listFeaturedProjects(3),
  listArticles().then((all) => all.slice(0, 3)),
  heroSlides(),
]);

/* پوستر اسلاید اول، بزرگ‌ترین عنصر قابل مشاهدهٔ صفحه (LCP) است. آدرسش را
   به Base می‌دهیم تا در <head> با preload اعلام شود و دانلودش هم‌زمان با
   خواندن سرصفحه شروع شود، نه بعد از رسیدن به تگ img.
   HeroSlider همین داده را از کش می‌گیرد، پس کوئری دوباره‌ای زده نمی‌شود. */
const lcp = slides[0]?.image ?? null;

const homeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'نماد نیرو',
    url: 'https://namadniroo.ir',
    inLanguage: 'fa-IR',
    publisher: { '@id': 'https://namadniroo.ir/#organization' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': 'https://namadniroo.ir/#localbusiness',
    name: 'شرکت کرمان نماد نیرو',
    url: 'https://namadniroo.ir',
    image: 'https://namadniroo.ir/assets/logo.png',
    telephone: '+983432521416',
    priceRange: '$$',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'کرمان',
      addressRegion: 'کرمان',
      addressCountry: 'IR',
    },
  },
];
---
<Base
  title="نماد نیرو | راه‌کارهای جامع انرژی پایدار"
  description="نماد نیرو از سال ۱۳۸۷ در کرمان: احداث نیروگاه خورشیدی، تأمین پنل و اینورتر از برندهای معتبر جهانی، و سرمایه‌گذاری در پروژه‌های تجدیدپذیر."
  schema={homeSchema}
  preloadImage={lcp ? { src: lcp.url, srcset: buildSrcset(lcp.key, lcp.width), sizes: '100vw' } : undefined}
>
  <h1 class="sr-only">
    نماد نیرو — احداث نیروگاه خورشیدی، تأمین تجهیزات و سرمایه‌گذاری در انرژی تجدیدپذیر
  </h1>
  <HeroSlider />
  <Stats />
  <PromoSlider />

  <section class="shop">
    <div class="wrap">
      <SectionHead eyebrow="فروشگاه تجهیزات" title="اینورترها و پنل‌های خورشیدی" moreHref="/shop" />
      <div class="products">
        {products.map((p) => <ProductCard p={p} showCat={false} />)}
      </div>
    </div>
  </section>

  <section class="projects">
    <div class="wrap">
      <SectionHead eyebrow="نمونه‌کارها" title="از کویر تا خط تولید" moreHref="/projects" moreLabel="همهٔ پروژه‌ها" />
      <div class="proj-grid">
        {projects.map((p, i) => <ProjectTile p={p} large={i === 0} />)}
      </div>
    </div>
  </section>

  <section class="magazine">
    <div class="wrap">
      <SectionHead eyebrow="مجلهٔ انرژی" title="دانش، بازار و اخبار" moreHref="/magazine" moreLabel="همهٔ مقاله‌ها" />
      <div class="mag-grid">
        {articles.map((a) => <ArticleCard a={a} />)}
      </div>
    </div>
  </section>

  <QuoteForm />
</Base>
