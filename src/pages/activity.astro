---
import Base from '../layouts/Base.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import DbImage from '../components/DbImage.astro';
import { breadcrumbSchema } from '../utils';
import { areaBlocks } from '../server/repos/slides';

const pageSchema = breadcrumbSchema([{ name: 'حوزه‌های فعالیت', href: '/activity' }]);

export const prerender = false;

const blocks = await areaBlocks();
---
<Base schema={pageSchema} title="حوزه‌های فعالیت | نماد نیرو" description="سه حوزهٔ فعالیت نماد نیرو: طراحی مهندسی نیروگاه، بازرگانی و تأمین تجهیزات خورشیدی، و اجرا و بهره‌برداری پروژه‌های تجدیدپذیر.">
  <PageHero
    crumb="حوزه‌های فعالیت"
    title="سه حوزه، یک شریک انرژی"
    lead="از طراحی و مهندسی تا تأمین تجهیزات و اجرا و بهره‌برداری نیروگاه؛ نماد نیرو در تمام مسیر همراه شماست."
  />

  {blocks.map((a, i) => (
    <section class:list={['area-block', a.reverse && 'is-reverse']} id={a.id}>
      <div class="wrap area-inner">
        <div class="area-visual">
          {a.image && (
            <DbImage image={a.image} sizes="(max-width: 900px) 92vw, 560px" priority={i === 0} decorative />
          )}
          <span class="area-badge"><Icon name={a.icon as never} /></span>
        </div>
        <div class="area-copy">
          <p class="eyebrow">{a.eyebrow}</p>
          <h2 class="area-title">{a.title}</h2>
          <p class="area-desc">{a.desc}</p>
          <ul class="area-list">
            {a.items.map((it) => <li>{it}</li>)}
          </ul>
          <a class="btn btn-solid" href={a.cta.href}>{a.cta.label}</a>
          <span class="area-proof">{a.proof.label} <b>{a.proof.value}</b> {a.proof.tail}</span>
        </div>
      </div>
    </section>
  ))}

  <RelatedArticles
    slugs={['epc-meaning', 'plant-components', 'om-plant']}
    title="پیش از شروع پروژه بخوانید"
  />

  <section class="cta-band">
    <div class="wrap">
      <h2>مطمئن نیستید کدام مسیر مناسب شماست؟</h2>
      <p>کارشناسان ما با یک تماس، بهترین حوزه را برای پروژهٔ شما پیشنهاد می‌دهند.</p>
      <a class="btn btn-solid" href="/#quote">درخواست مشاوره</a>
    </div>
  </section>
</Base>
