---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FilterBar from '../components/FilterBar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PortfolioDownload from '../components/PortfolioDownload.astro';
import { filters } from '../data/site';
import { breadcrumbSchema } from '../utils';
import { listProjects } from '../server/repos/content';
import { getPageContent } from '../server/repos/pageContent';
import { projectsPage } from '../data/pages';

export const prerender = false;

const [projects, c] = await Promise.all([listProjects(), getPageContent(projectsPage)]);

const pageSchema = breadcrumbSchema([{ name: 'پروژه‌ها', href: '/projects' }]);
---
<Base schema={pageSchema} title={c.seo.title} description={c.seo.description}>
  <PageHero
    crumb="پروژه‌ها"
    title={c.hero.title}
    lead={c.hero.lead}
  >
    {c.stats.length > 0 && (
      <div class="page-stats">
        {c.stats.map((s) => (
          <div class="page-stat"><b>{s.value}{s.unit && <i>{s.unit}</i>}</b><span>{s.caption}</span></div>
        ))}
      </div>
    )}
  </PageHero>

  <section class="plist-sec">
    <div class="wrap">
      <FilterBar items={filters.projects} label="فیلتر پروژه‌ها" />
      <div class="plist">
        {projects.map((p) => <ProjectCard p={p} />)}
      </div>
    </div>
  </section>

  <PortfolioDownload alt={true} />

  <section class="cta-band">
    <div class="wrap">
      <h2>{c.cta.title}</h2>
      <p>{c.cta.text}</p>
      <a class="btn btn-solid" href={c.cta.href}>{c.cta.label}</a>
    </div>
  </section>
</Base>
