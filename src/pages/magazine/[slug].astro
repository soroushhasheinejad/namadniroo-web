---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { categoryLabel } from '../../data/site';
import { fa, breadcrumbSchema } from '../../utils';
import { listArticles } from '../../server/repos/content';
import { renderMarkdown } from '../../server/content/markdown';

export const prerender = false;

const { slug } = Astro.params;

const all = await listArticles();
const article = all.find((a) => a.slug === slug);

// نشانی نامعتبر یا مقاله‌ای که پیش‌نویس شده است
if (!article) return Astro.rewrite('/404');

const html = await renderMarkdown(article.body);

/* فهرست مطالب از روی تیترهای h2. شناسه‌ها را پردازشگر مارک‌داون می‌سازد؛
   لینک‌های پرشی هم به خواننده کمک می‌کنند و هم گاهی گوگل آن‌ها را زیر
   نتیجه نشان می‌دهد. */
const toc = [...html.matchAll(/<h2 id="([^"]+)">([\s\S]*?)<\/h2>/g)].map((m) => ({
  id: m[1]!,
  text: m[2]!.replace(/<[^>]+>/g, '').trim(),
}));

/* مطالب مرتبط: اول هم‌دسته، بعد بقیه — تا مقالهٔ دسته‌ای که فقط دو عضو
   دارد هم سه پیشنهاد داشته باشد. */
const others = all.filter((a) => a.slug !== article.slug);
const related = [
  ...others.filter((a) => a.category === article.category),
  ...others.filter((a) => a.category !== article.category),
].slice(0, 3);

const published = article.publishedAt?.toISOString().slice(0, 10);
const description = article.seoDescription || article.title;

const pageSchema = [
  breadcrumbSchema([
    { name: 'مجله', href: '/magazine' },
    { name: categoryLabel[article.category], href: '/magazine' },
    { name: article.title, href: `/magazine/${article.slug}` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.title,
    description,
    inLanguage: 'fa-IR',
    articleSection: categoryLabel[article.category],
    wordCount: article.body.split(/\s+/).filter(Boolean).length,
    ...(published ? { datePublished: published } : {}),
    dateModified: article.updatedAt.toISOString().slice(0, 10),
    author: { '@type': 'Organization', name: 'نماد نیرو' },
    publisher: { '@id': 'https://namadniroo.ir/#organization' },
    mainEntityOfPage: `https://namadniroo.ir/magazine/${article.slug}`,
    ...(article.cover
      ? { image: new URL(article.cover.url, 'https://namadniroo.ir').href }
      : {}),
  },
];
---
<Base
  title={article.seoTitle || `${article.title} | مجلهٔ نماد نیرو`}
  description={description}
  image={article.cover?.url}
  type="article"
  schema={pageSchema}
  noindex={article.noindex}
  canonical={article.canonicalOverride}
>
  <Fragment slot="head">
    {published && <meta property="article:published_time" content={published} />}
    <meta property="article:modified_time" content={article.updatedAt.toISOString()} />
    <meta property="article:section" content={categoryLabel[article.category]} />
  </Fragment>
  <article class="article">
    <div class="wrap article-head">
      <p class="breadcrumb">
        <a href="/">خانه</a><span>/</span><a href="/magazine">مجله</a><span>/</span>{categoryLabel[article.category]}
      </p>
      <span class="mag-tag">{categoryLabel[article.category]}</span>
      <h1 class="article-title">{article.title}</h1>
      <p class="article-meta">{article.dateFa} · {fa(article.readTime)} دقیقه مطالعه</p>
    </div>

    {toc.length > 2 && (
      <nav class="wrap article-toc" aria-label="فهرست مطالب">
        <details open>
          <summary>فهرست مطالب</summary>
          <ol>
            {toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
          </ol>
        </details>
      </nav>
    )}

    <div class="wrap article-body" set:html={html} />
  </article>

  {related.length > 0 && (
    <section class="magazine">
      <div class="wrap">
        <header class="section-head">
          <p class="eyebrow">مطالب مرتبط</p>
          <h2 class="section-title">در همین دسته</h2>
        </header>
        <div class="mag-grid">
          {related.map((a) => <ArticleCard a={a} />)}
        </div>
      </div>
    </section>
  )}

  <section class="cta-band">
    <div class="wrap">
      <h2>سؤالی دربارهٔ پروژه‌تان دارید؟</h2>
      <p>کارشناسان ما فراتر از مقاله، مستقیم راهنمایی‌تان می‌کنند.</p>
      <a class="btn btn-solid" href="/#quote">درخواست مشاوره</a>
    </div>
  </section>
</Base>
