---
import { ROUTES, TARIFF, UPDATED_AT, YIELD_BY_REGION, calculate } from '../../data/solarModel';
import { fa } from '../../utils';
import { getSetting } from '../../server/repos/content';
import { site as siteDefaults } from '../../data/site';

export const prerender = false;

/**
 * نسخهٔ چاپی برآورد.
 *
 * چرا HTML چاپی و نه تولید فایل PDF روی سرور: متن فارسی در کتابخانه‌های
 * PDF باید حرف‌به‌حرف به هم چسبانده و راست‌چین شود، و هیچ‌کدام از
 * کتابخانه‌های سبک این کار را درست انجام نمی‌دهند. مرورگر این کار را
 * بی‌نقص بلد است و «ذخیره به PDF» در همهٔ مرورگرها و روی موبایل هم هست.
 * نتیجه یک PDF واقعی با فونت خود سایت است، بدون هیچ وابستگی تازه.
 *
 * عددها اینجا دوباره روی سرور حساب می‌شوند و از مرورگر گرفته نمی‌شوند،
 * تا چیزی که در برگه چاپ می‌شود قابل اتکا باشد.
 */

const q = Astro.url.searchParams;
const num = (key: string, fallback: number) => {
  const v = Number(q.get(key));
  return Number.isFinite(v) && v > 0 ? v : fallback;
};

const investment = num('investment', 10_000_000_000);
const mount = q.get('mount') === 'roof' ? 'roof' : 'ground';
const regionKey = q.get('region') && YIELD_BY_REGION[q.get('region')!] ? q.get('region')! : 'high';
const region = YIELD_BY_REGION[regionKey]!;

const assumptions = {
  equipmentCostPerKw: num('equip', 35) * 1_000_000,
  siteCostPerKw: num('site', 35) * 1_000_000,
  yieldPerKw: region.kwhPerKw,
  mount: mount as 'roof' | 'ground',
  omRate: num('om', 1.5) / 100,
  degradation: 0.007,
  years: 20,
};

const mid = calculate(investment, assumptions);

const routes = ROUTES.map((route) => {
  const tariff = route.key === 'satba' ? TARIFF.satba[mid.scale] : TARIFF[route.key];
  return { route, tariff, result: tariff === null ? null : calculate(investment, { ...assumptions, tariff }) };
});

const contact = await getSetting('site', siteDefaults).catch(() => siteDefaults);

const grouped = (n: number) => fa(Math.round(n).toLocaleString('en-US'));
const toman = (n: number): string => {
  if (n >= 1_000_000_000_000) return `${fa((n / 1_000_000_000_000).toFixed(1))} هزار میلیارد تومان`;
  if (n >= 1_000_000_000) return `${fa((n / 1_000_000_000).toFixed(n < 10_000_000_000 ? 1 : 0))} میلیارد تومان`;
  if (n >= 1_000_000) return `${fa(Math.round(n / 1_000_000))} میلیون تومان`;
  return `${grouped(n)} تومان`;
};
const capacity = (kw: number) =>
  kw >= 1000 ? `${fa((kw / 1000).toFixed(2))} مگاوات` : `${fa(Math.round(kw))} کیلووات`;
const area = (m2: number) =>
  m2 >= 10_000 ? `${fa((m2 / 10_000).toFixed(1))} هکتار` : `${fa(Math.round(m2))} مترمربع`;

const today = new Intl.DateTimeFormat('fa-IR', { dateStyle: 'long' }).format(new Date());
---
<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>برآورد سرمایه‌گذاری نیروگاه خورشیدی — نماد نیرو</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preload" href="/fonts/DanaVF.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <div class="sheet">
    <header class="head">
      <img src="/assets/logo.png" alt="نماد نیرو" width="160" height="35" />
      <div class="head-meta">
        <b>برآورد سرمایه‌گذاری نیروگاه خورشیدی</b>
        <span>تاریخ تهیه: {today}</span>
      </div>
    </header>

    <p class="warn">
      <b>این برآورد تقریبی است و طرح توجیهی نیست.</b>
      قیمت تجهیزات با نرخ ارز و نرخ فروش برق با مصوبه‌های وزارت نیرو تغییر می‌کند،
      و هزینهٔ زمین و فاصله تا شبکه در هر پروژه فرق دارد. برای تصمیم سرمایه‌گذاری،
      امکان‌سنجی اختصاصی لازم است.
    </p>

    <section>
      <h2>فرض‌های این برآورد</h2>
      <table class="kv">
        <tbody>
          <tr><th>سرمایهٔ موردنظر</th><td>{toman(investment)}</td></tr>
          <tr><th>نوع نصب</th><td>{mount === 'ground' ? 'زمینی' : 'پشت‌بام'}</td></tr>
          <tr><th>منطقه</th><td>{region.label}</td></tr>
          <tr><th>تولید ویژه</th><td>{fa(region.kwhPerKw)} کیلووات‌ساعت در سال به ازای هر کیلووات</td></tr>
          <tr><th>هزینهٔ تجهیزات و نصب</th><td>{fa(assumptions.equipmentCostPerKw / 1_000_000)} میلیون تومان بر کیلووات</td></tr>
          {mount === 'ground' && (
            <tr><th>زمین، پست و خط انتقال</th><td>{fa(assumptions.siteCostPerKw / 1_000_000)} میلیون تومان بر کیلووات</td></tr>
          )}
          <tr><th>نگه‌داری سالانه</th><td>{fa((assumptions.omRate * 100).toFixed(1))} درصد سرمایه</td></tr>
          <tr><th>افت راندمان</th><td>۰٫۷ درصد در سال</td></tr>
          <tr><th>افق محاسبه</th><td>۲۰ سال — تورم لحاظ نشده، همه‌چیز به قیمت امروز</td></tr>
        </tbody>
      </table>
    </section>

    <section>
      <h2>نتیجهٔ تقریبی</h2>
      <div class="cards">
        <div><span>ظرفیت قابل احداث</span><b>حدود {capacity(mid.capacityKw)}</b></div>
        <div><span>تولید سال اول</span><b>حدود {grouped(mid.firstYearProductionKwh)} kWh</b></div>
        <div><span>{mount === 'ground' ? 'زمین لازم' : 'سقف لازم'}</span><b>حدود {area(mid.areaM2)}</b></div>
      </div>
    </section>

    <section>
      <h2>آورده، به تفکیک روش فروش برق</h2>
      <table class="grid">
        <thead>
          <tr><th>روش</th><th>نرخ (تومان/kWh)</th><th>خالص سال اول</th><th>بازگشت سرمایه</th><th>جمع ۲۰ سال</th></tr>
        </thead>
        <tbody>
          {routes.map(({ route, tariff, result }) => (
            <tr>
              <th>{route.title}</th>
              {result === null ? (
                <td colspan="4" class="na">
                  برای این ظرفیت نرخ مصوب ندارد؛ مصوبهٔ ۱۴۰۵ تا سقف یک مگاوات است
                  و نیروگاه بزرگ‌تر از راه بورس انرژی یا مزایده قیمت‌گذاری می‌شود.
                </td>
              ) : (
                <>
                  <td>{grouped(tariff!)}</td>
                  <td>{toman(result.firstYearNet)}</td>
                  <td>{result.paybackYears ? `${fa(result.paybackYears.toFixed(1))} سال` : 'بیش از ۲۰ سال'}</td>
                  <td>{toman(result.totalNet)}</td>
                </>
              )}
            </tr>
          ))}
        </tbody>
      </table>
      <p class="note">
        نرخ بورس انرژی سقف است نه قیمت قطعی: تعرفه‌ای که صنایع مشمول در صورت
        نخریدن برق سبز می‌پردازند. قیمت واقعی توافقی و معمولاً پایین‌تر است.
      </p>
    </section>

    <section class="break-avoid">
      <h2>سه روش فروش برق</h2>
      {ROUTES.map((r) => (
        <div class="route">
          <h3>{r.title}</h3>
          <p>{r.summary}</p>
          <div class="pc">
            <div><b>مزیت‌ها</b><ul>{r.pros.map((p) => <li>{p}</li>)}</ul></div>
            <div><b>ملاحظه‌ها</b><ul>{r.cons.map((c) => <li>{c}</li>)}</ul></div>
          </div>
        </div>
      ))}
    </section>

    <footer class="foot">
      <div>
        <b>{contact.name}</b>
        <span>{contact.city} · <span dir="ltr">{contact.phone}</span></span>
        <span>namadniroo.ir</span>
      </div>
      <p>فرض‌ها بر پایهٔ نرخ‌های منتشرشده تا {UPDATED_AT}. برای برآورد دقیق پروژه، با ما تماس بگیرید.</p>
    </footer>
  </div>

  <div class="bar no-print">
    <button type="button" id="printBtn">ذخیره به‌صورت PDF یا چاپ</button>
    <a href="/solar-calculator">بازگشت به ماشین‌حساب</a>
  </div>

  <script>
    const btn = document.getElementById('printBtn');
    btn?.addEventListener('click', () => window.print());

    /* اگر کاربر مستقیم از فرم آمده، پنجرهٔ چاپ خودکار باز می‌شود — ولی فقط
       پس از لود کامل فونت، وگرنه برگه با فونت پیش‌فرض چاپ می‌شود. */
    if (new URLSearchParams(location.search).get('print') === '1') {
      const go = () => setTimeout(() => window.print(), 300);
      if (document.fonts?.ready) document.fonts.ready.then(go);
      else addEventListener('load', go);
    }
  </script>

  <style is:global>
    @font-face {
      font-family: "Dana";
      src: url("/fonts/DanaVF.woff2") format("woff2");
      font-weight: 100 900;
      font-display: swap;
    }

    /* برگه روی کاغذ سفید چاپ می‌شود، پس این صفحه برخلاف بقیهٔ سایت روشن
       است — تم تیره روی کاغذ هم بد خوانده می‌شود هم تونر هدر می‌دهد. */
    :root { --ink: #16181b; --muted: #5b6168; --line: #d8dde2; --yellow: #b8860b; --navy: #0A3D5D; }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: #f2f4f6;
      color: var(--ink);
      font-family: "Dana", system-ui, sans-serif;
      font-size: 13px;
      line-height: 1.9;
    }

    .sheet {
      max-width: 820px;
      margin: 24px auto 90px;
      padding: 38px 42px;
      background: #fff;
      border: 1px solid var(--line);
    }

    .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; padding-bottom: 16px; border-bottom: 2px solid var(--navy); }
    .head img { height: 34px; width: auto; }
    .head-meta { text-align: left; }
    .head-meta b { display: block; font-size: 15px; color: var(--navy); }
    .head-meta span { color: var(--muted); font-size: 12px; }

    .warn {
      margin: 18px 0 24px;
      padding: 12px 14px;
      border: 1px solid #e6c37a;
      border-inline-start: 3px solid var(--yellow);
      background: #fdf7e9;
      font-size: 12.5px;
    }
    .warn b { color: #8a6100; }

    section { margin-bottom: 26px; }
    h2 { margin: 0 0 12px; font-size: 14.5px; color: var(--navy); border-bottom: 1px solid var(--line); padding-bottom: 6px; }
    h3 { margin: 0 0 4px; font-size: 13px; }

    table { width: 100%; border-collapse: collapse; }
    .kv th { width: 38%; text-align: start; font-weight: 600; color: var(--muted); padding: 6px 0; vertical-align: top; }
    .kv td { padding: 6px 0; }
    .kv tr + tr th, .kv tr + tr td { border-top: 1px solid #eef1f4; }

    .grid th, .grid td { border: 1px solid var(--line); padding: 8px 10px; text-align: start; }
    .grid thead th { background: #f6f8fa; font-size: 12px; color: var(--muted); font-weight: 600; }
    .grid tbody th { font-weight: 700; width: 26%; }
    .grid .na { color: var(--muted); font-size: 12px; }

    .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .cards div { border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; background: #fafbfc; }
    .cards span { display: block; color: var(--muted); font-size: 11.5px; }
    .cards b { display: block; margin-top: 4px; font-size: 16px; color: var(--navy); }

    .note { margin: 10px 0 0; color: var(--muted); font-size: 11.5px; }

    .route { margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid #eef1f4; }
    .route:last-child { border-bottom: 0; }
    .route p { margin: 0 0 8px; color: #33383d; }
    .pc { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .pc b { font-size: 12px; color: var(--muted); }
    .pc ul { margin: 4px 0 0; padding-inline-start: 16px; }
    .pc li { font-size: 12px; margin-bottom: 3px; }

    .foot { margin-top: 26px; padding-top: 14px; border-top: 2px solid var(--navy); display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; }
    .foot b { display: block; color: var(--navy); }
    .foot span { display: block; color: var(--muted); font-size: 12px; }
    .foot p { margin: 0; max-width: 46ch; color: var(--muted); font-size: 11.5px; text-align: end; }

    .bar {
      position: fixed; inset-inline: 0; bottom: 0;
      display: flex; justify-content: center; align-items: center; gap: 14px;
      padding: 12px; background: #16181b;
    }
    .bar button {
      padding: 9px 22px; border: 0; border-radius: 8px;
      background: #FFC41A; color: #16181b;
      font-family: inherit; font-size: 13.5px; font-weight: 700; cursor: pointer;
    }
    .bar a { color: #c9ced3; font-size: 13px; text-decoration: none; }
    .bar a:hover { color: #fff; }

    @media print {
      body { background: #fff; }
      .sheet { margin: 0; padding: 0; border: 0; max-width: none; }
      .no-print { display: none !important; }
      section, .route { break-inside: avoid; }
      .break-avoid { break-before: auto; }
      @page { margin: 14mm; }
    }

    @media (max-width: 640px) {
      .sheet { padding: 22px 18px; margin: 12px; }
      .cards, .pc { grid-template-columns: 1fr; }
      .head { flex-direction: column; }
      .head-meta { text-align: start; }
      .foot { flex-direction: column; align-items: flex-start; }
      .foot p { text-align: start; }
    }
  </style>
</body>
</html>
