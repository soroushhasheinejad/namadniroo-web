---
import ShopListing from '../../components/ShopListing.astro';
import ProductDetail from '../../components/ProductDetail.astro';
import { listProducts } from '../../server/repos/content';
import { typeBySlug } from '../../data/shopTaxonomy';

export const prerender = false;

/**
 * /shop/{slug} دو نوع صفحه است: نوع کالا (/shop/inverter) یا محصول
 * (/shop/fronius-primo). نشانی محصول‌ها از قبل ایندکس شده و نباید عوض
 * شود، پس نوع‌ها کنارشان در همین مسیر نشسته‌اند؛ نام نوع‌ها با نامک هیچ
 * محصولی یکی نیست.
 */
const { slug } = Astro.params;
const all = await listProducts();
const type = typeBySlug(slug!);
const p = type ? undefined : all.find((x) => x.slug === slug);

// نشانی نامعتبر یا محصولی که از انتشار خارج شده
if (!type && !p) return Astro.rewrite('/404');
---
{type ? <ShopListing type={type} all={all} /> : <ProductDetail p={p!} all={all} />}
