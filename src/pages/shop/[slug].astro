---
import Base from '../../layouts/Base.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import ProductCard from '../../components/ProductCard.astro';
import DbImage from '../../components/DbImage.astro';
import { categoryLabel } from '../../data/site';
import { breadcrumbSchema } from '../../utils';
import { listProducts } from '../../server/repos/content';

export const prerender = false;

const { slug } = Astro.params;

/* یک بار خوانده و کش می‌شود؛ هم محصول موردنظر و هم مرتبط‌ها از همین فهرست
   درمی‌آیند، پس صفحه فقط یک کوئری می‌زند نه دو تا. */
const all = await listProducts();
const p = all.find((x) => x.slug === slug);

// نشانی نامعتبر یا محصولی که از انتشار خارج شده
if (!p) return Astro.rewrite('/404');

/* مقاله‌های آموزشی مرتبط با نوع محصول، برای لینک‌سازی داخلی */
const guides: Record<typeof p.kind, string[]> = {
  inverter: ['inverter-role', 'ongrid-offgrid', 'performance-ratio'],
  panel: ['how-panel-works', 'panel-washing', 'plant-components'],
  storage: ['ongrid-offgrid', 'inverter-role', 'solar-vs-generator'],
  accessory: ['plant-components', 'maintenance-kpi', 'om-plant'],
};

const related = all.filter((x) => x.slug !== p.slug && x.cat === p.cat).slice(0, 4);

// نام برند بدون &nbsp; که در بعضی رکوردها برای جلوگیری از شکست خط آمده
const brandPlain = p.brand.replace(/&nbsp;/g, ' ').trim();
const description =
  p.seoDescription ||
  `${p.name} — ${brandPlain} — ${p.spec} ${p.specUnit}. استعلام قیمت، موجودی و مشاوره فنی از نماد نیرو.`;

const pageSchema = [
  breadcrumbSchema([
    { name: 'فروشگاه', href: '/shop' },
    { name: p.name, href: `/shop/${p.slug}` },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    description,
    brand: { '@type': 'Brand', name: brandPlain },
    category: categoryLabel[p.cat],
    ...(p.image ? { image: new URL(p.image.url, 'https://namadniroo.ir').href } : {}),
    /* فروشگاه فعلاً لیدجن است و قیمت آنلاین ندارد. `Offer` را با وضعیت
       «استعلامی» می‌آوریم تا گوگل محصول را کامل بشناسد بدون این‌که قیمتی
       ادعا کنیم که وجود ندارد. */
    offers: {
      '@type': 'Offer',
      url: `https://namadniroo.ir/shop/${p.slug}`,
      priceCurrency: 'IRR',
      availability: 'https://schema.org/InStock',
      ...(p.price ? { price: p.price } : { price: '0' }),
      seller: { '@id': 'https://namadniroo.ir/#organization' },
    },
  },
];
---
<Base
  title={p.seoTitle || `${p.name} | فروشگاه نماد نیرو`}
  description={description}
  image={p.image?.url}
  type="product"
  schema={pageSchema}
  noindex={p.noindex}
>
  <div class="article-head">
    <div class="wrap">
      <p class="breadcrumb">
        <a href="/">خانه</a><span>/</span><a href="/shop">فروشگاه</a><span>/</span>{categoryLabel[p.cat]}
      </p>
      <span class="mag-tag">{categoryLabel[p.cat]}</span>
      <h1 class="article-title">{p.name}</h1>
      <p class="article-meta" dir="ltr">{p.brand} · {p.spec} {p.specUnit}</p>
    </div>
  </div>

  <section class="about-sec">
    <div class="wrap about-intro">
      <div class="product-thumb product-hero">
        {p.image
          ? <DbImage image={p.image} class="product-img" sizes="(max-width: 800px) 90vw, 620px" priority />
          : <span class="thumb-brand" set:html={p.brand} />}
      </div>
      <div>
        <p class="lead-lg">{p.brand} · {p.spec} {p.specUnit}</p>
        {p.body
          ? <p>{p.body}</p>
          : (
            <p>
              محصولی از دستهٔ محصولات {categoryLabel[p.cat]} نماد نیرو، مناسب برای پروژه‌های
              {p.cat === 'home' ? ' خانگی و تجاری کوچک' : ' صنعتی و نیروگاهی'}.
              مشخصات فنی کامل، قیمت روز، موجودی و زمان تحویل را از کارشناسان فروش استعلام بگیرید.
            </p>
          )}
        <a class="btn btn-solid" href="/#quote">استعلام قیمت و موجودی</a>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="shop">
      <div class="wrap">
        <header class="section-head">
          <p class="eyebrow">محصولات مرتبط</p>
          <h2 class="section-title">در همین دسته</h2>
        </header>
        <div class="products">
          {related.map((r) => <ProductCard p={r} />)}
        </div>
      </div>
    </section>
  )}

  <RelatedArticles slugs={guides[p.kind]} title="راهنمای خرید و بهره‌برداری" />

  <section class="cta-band">
    <div class="wrap">
      <h2>دربارهٔ این محصول سؤال دارید؟</h2>
      <p>کارشناسان ما مشخصات فنی، قیمت و زمان تحویل را برایتان مشخص می‌کنند.</p>
      <a class="btn btn-solid" href="/#quote">درخواست مشاوره</a>
    </div>
  </section>
</Base>
