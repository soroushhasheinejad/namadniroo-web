---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FilterBar from '../components/FilterBar.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { filters } from '../data/site';
import { breadcrumbSchema } from '../utils';
import { listArticles } from '../server/repos/content';

export const prerender = false;

const articles = await listArticles();

/* دسته‌ای که مقالهٔ منتشرشده ندارد دکمهٔ فیلتر هم نمی‌گیرد — کلیک روی آن
   صفحهٔ خالی نشان می‌داد. */
const articleFilters = filters.articles.filter(
  (f) => f.key === 'all' || articles.some((a) => a.category === f.key),
);

const pageSchema = [
  breadcrumbSchema([{ name: 'مجله', href: '/magazine' }]),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'مجلهٔ انرژی نماد نیرو',
    url: 'https://namadniroo.ir/magazine',
    inLanguage: 'fa-IR',
    publisher: { '@id': 'https://namadniroo.ir/#organization' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: articles.map((a, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://namadniroo.ir/magazine/${a.slug}`,
        name: a.title,
      })),
    },
  },
];
---
<Base
  schema={pageSchema}
  title="مجله انرژی خورشیدی؛ آموزش نیروگاه خورشیدی | نماد نیرو"
  description="مقاله‌های کاربردی دربارهٔ نیروگاه خورشیدی: اجزا و اینورتر، آنگرید و آفگرید، نگهداری و O&M، شاخص PR، قرارداد EPC و درآمد و سود نیروگاه خورشیدی."
>
  <PageHero
    crumb="مجله"
    title="مجلهٔ انرژی"
    lead="راهنمای ساده و کاربردی دربارهٔ نیروگاه خورشیدی، تجهیزات، نگه‌داری و اقتصاد انرژی — برای صاحبان صنایع و علاقه‌مندان."
  />

  <section class="mag-sec">
    <div class="wrap">
      <FilterBar items={articleFilters} label="فیلتر مقاله‌ها" />
      <div class="mag-grid">
        {articles.map((a) => <ArticleCard a={a} />)}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2>سؤالی دربارهٔ پروژه‌تان دارید؟</h2>
      <p>کارشناسان ما فراتر از مقاله، مستقیم راهنمایی‌تان می‌کنند.</p>
      <a class="btn btn-solid" href="/#quote">درخواست مشاوره</a>
    </div>
  </section>
</Base>
