---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FilterBar from '../components/FilterBar.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { filters } from '../data/site';
import { breadcrumbSchema } from '../utils';
import { listArticles } from '../server/repos/content';
import { seoProps } from '../server/seo/pageSeo';
import { getPageContent } from '../server/repos/pageContent';
import { magazinePage } from '../data/pages';

export const prerender = false;

const articles = await listArticles();

/* دسته‌ای که مقالهٔ منتشرشده ندارد دکمهٔ فیلتر هم نمی‌گیرد — کلیک روی آن
   صفحهٔ خالی نشان می‌داد. */
const articleFilters = filters.articles.filter(
  (f) => f.key === 'all' || articles.some((a) => a.category === f.key),
);

const pageSchema = [
  breadcrumbSchema([{ name: 'مجله', href: '/magazine' }]),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'مجلهٔ انرژی نماد نیرو',
    url: 'https://namadniroo.ir/magazine',
    inLanguage: 'fa-IR',
    publisher: { '@id': 'https://namadniroo.ir/#organization' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: articles.map((a, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://namadniroo.ir/magazine/${a.slug}`,
        name: a.title,
      })),
    },
  },
];
const c = await getPageContent(magazinePage);
const seo = await seoProps(c.seo);

---
<Base {...seo}
  schema={pageSchema}
>
  <PageHero
    crumb="مجله"
    title={c.hero.title}
    lead={c.hero.lead}
  />

  <section class="mag-sec">
    <div class="wrap">
      <FilterBar items={articleFilters} label="فیلتر مقاله‌ها" />
      <div class="mag-grid">
        {articles.map((a) => <ArticleCard a={a} />)}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2>{c.cta.title}</h2>
      <p>{c.cta.text}</p>
      <a class="btn btn-solid" href={c.cta.href}>{c.cta.label}</a>
    </div>
  </section>
</Base>
