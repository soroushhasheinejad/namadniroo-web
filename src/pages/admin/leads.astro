---
import Admin from '../../layouts/Admin.astro';
import { allLeads, listLeads } from '../../server/repos/leads';
import { applyLeadUpdate, STATUS_LABELS } from '../../server/services/crm';
import { channelLabel } from '../../server/analytics/channel';
import { fa } from '../../utils';
import { displayPhone } from '../../lib/phone';
import type { LeadStatus } from '../../server/db/schema';

export const prerender = false;

const STATUSES: { key: LeadStatus | 'all'; label: string }[] = [
  { key: 'all', label: 'همه' },
  ...(Object.keys(STATUS_LABELS) as LeadStatus[]).map((key) => ({ key, label: STATUS_LABELS[key] })),
];

let saved = false;

/* تغییر وضعیت و یادداشت با فرم معمولی انجام می‌شود، بدون جاوااسکریپت.
   پنل داخلی است و ساده‌ترین راهی که همیشه کار می‌کند بهترین است. */
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = Number(form.get('id'));
  if (id) {
    /* از سرویس CRM می‌گذرد و نه مستقیم از مخزن: تغییر وضعیت باید زمان
       اولین تماس را مهر بزند و در خط زمانی ثبت شود، چه از این فهرست
       انجام شود چه از خود پرونده. */
    await applyLeadUpdate({
      id,
      userId: Astro.locals.user?.id,
      patch: {
        status: String(form.get('status') ?? 'new') as LeadStatus,
        notes: String(form.get('notes') ?? '').slice(0, 2000) || null,
      },
    });
    saved = true;
  }
}

const params = Astro.url.searchParams;
const status = (params.get('status') ?? 'all') as LeadStatus | 'all';
const q = params.get('q') ?? '';
const page = Number(params.get('page') ?? 1) || 1;
const due = params.get('due') === '1';

/* خروجی CSV همان فیلتر فعلی را دنبال می‌کند، پس آنچه روی صفحه دیده می‌شود
   همان چیزی است که دانلود می‌شود. */
if (params.get('export') === 'csv') {
  const rows = await allLeads({ status, q, due });
  const esc = (v: unknown) => `"${String(v ?? '').replace(/"/g, '""')}"`;
  const csv =
    '﻿' + // تا اکسل فارسی را درست باز کند
    [
      ['تاریخ ثبت', 'نام', 'تلفن', 'تلفن یکتا', 'ظرفیت', 'برآورد', 'حوزه', 'راه تماس', 'مبدأ',
       'کانال ورود', 'کمپین', 'وضعیت', 'اولین تماس', 'بسته‌شده', 'مبلغ قرارداد', 'ظرفیت قرارداد (kW)',
       'دلیل باخت', 'یادداشت'],
      ...rows.map((l) => [
        l.createdAt.toISOString(),
        l.name,
        l.phone,
        l.phoneNormalized,
        l.capacity,
        l.estimate,
        l.area,
        l.contactVia,
        l.source,
        channelLabel(l.firstChannel ?? l.channel),
        [l.firstUtmSource, l.firstUtmMedium, l.firstUtmCampaign].filter(Boolean).join(' / '),
        l.status,
        l.firstContactAt?.toISOString() ?? '',
        l.closedAt?.toISOString() ?? '',
        l.dealValue ?? '',
        l.capacityKw ?? '',
        l.lostReason ?? '',
        l.notes,
      ]),
    ]
      .map((r) => r.map(esc).join(','))
      .join('\n');

  return new Response(csv, {
    headers: {
      'Content-Type': 'text/csv; charset=utf-8',
      'Content-Disposition': `attachment; filename="namadniroo-leads-${new Date().toISOString().slice(0, 10)}.csv"`,
    },
  });
}

const result = await listLeads({ status, q, page, due });

/** حفظ فیلترهای فعلی هنگام ساخت لینک صفحه */
const pageLink = (n: number) => {
  const next = new URLSearchParams(params);
  next.set('page', String(n));
  return `?${next}`;
};

const exportLink = () => {
  const next = new URLSearchParams(params);
  next.set('export', 'csv');
  next.delete('page');
  return `?${next}`;
};

const statusLabel = Object.fromEntries(STATUSES.map((s) => [s.key, s.label]));
---
<Admin
  title="درخواست‌ها"
  lead={`${fa(result.total)} درخواست ثبت‌شده. وضعیت هر کدام را به‌روز کنید تا پیگیری از دست نرود.`}
>
  <a slot="actions" class="a-btn" href={exportLink()}>دانلود CSV</a>

  {saved && <p class="a-msg a-msg-ok">تغییرات ذخیره شد.</p>}

  <form class="a-filters" method="GET">
    <input
      class="a-input"
      type="search"
      name="q"
      value={q}
      placeholder="جست‌وجو در نام یا شمارهٔ تماس"
      aria-label="جست‌وجو"
    />
    <select class="a-select" name="status" aria-label="فیلتر وضعیت">
      {STATUSES.map((s) => (
        <option value={s.key} selected={s.key === status}>{s.label}</option>
      ))}
    </select>
    <button class="a-btn" type="submit">اعمال</button>
    {/* سررسید همراه بقیهٔ فیلترها می‌رود تا با یک کلیک برداشته شود */}
    <input type="hidden" name="due" value={due ? '1' : ''} />
    <a class:list={['a-btn', 'a-btn-sm', due && 'a-btn-primary']} href={due ? '/admin/leads' : '?due=1'}>
      فقط سررسیدشده‌ها
    </a>
    {(q || status !== 'all' || due) && <a class="a-btn a-btn-sm" href="/admin/leads">حذف فیلترها</a>}
  </form>

  {result.rows.length === 0 ? (
    <div class="a-card"><p class="a-empty">درخواستی با این فیلتر پیدا نشد.</p></div>
  ) : (
    result.rows.map((l) => (
      <div class="a-card">
        <div class="a-row">
          <div>
            <h2 style="margin-bottom:6px">
              <a href={`/admin/leads/${l.id}`} class="lead-link">{l.name}</a>
            </h2>
            <p style="margin:0">
              <a href={`tel:${l.phoneNormalized ?? l.phone}`} dir="ltr">
                {l.phoneNormalized ? displayPhone(l.phoneNormalized) : l.phone}
              </a>
            </p>
            <p class="a-hint" style="margin-top:8px">
              {l.createdAt.toLocaleString('fa-IR')}
              {l.area && <> · حوزه: {l.area}</>}
              {l.capacity && <> · ظرفیت: {l.capacity}</>}
            </p>
            {l.contactVia && (
              <p class="a-hint" style="margin-top:2px">
                ترجیح تماس: <b>{l.contactVia}</b>
                {l.contactVia === 'واتساپ' && l.phoneNormalized && (
                  <> · <a href={`https://wa.me/${l.phoneNormalized.replace(/^\+/, '')}`} target="_blank" rel="noopener">باز کردن گفت‌وگو</a></>
                )}
              </p>
            )}
            {l.source && <p class="a-hint" dir="ltr" style="margin-top:2px">مبدأ: {l.source}</p>}
            {l.estimate && (
              <p class="a-estimate">
                <span>برآوردی که خودش دیده بود</span>
                {l.estimate}
              </p>
            )}
            {(l.firstChannel || l.channel) && (
              <p class="a-hint" style="margin-top:2px">
                کانال ورود: <b>{channelLabel(l.firstChannel ?? l.channel)}</b>
                {(l.firstUtmSource || l.firstUtmCampaign) && (
                  <span dir="ltr"> · {[l.firstUtmSource, l.firstUtmMedium, l.firstUtmCampaign].filter(Boolean).join(' / ')}</span>
                )}
              </p>
            )}
            {l.nextFollowUpAt && (
              <p class:list={['a-hint', 'follow', l.nextFollowUpAt <= new Date() && 'is-due']} style="margin-top:2px">
                قرار پیگیری: {l.nextFollowUpAt.toLocaleDateString('fa-IR')}
                {l.nextFollowUpAt <= new Date() && ' — سررسید شده'}
              </p>
            )}
          </div>

          <form method="POST">
            <input type="hidden" name="id" value={l.id} />
            <div class="a-field">
              <label for={`status-${l.id}`}>وضعیت</label>
              <select class="a-select" id={`status-${l.id}`} name="status">
                {STATUSES.filter((s) => s.key !== 'all').map((s) => (
                  <option value={s.key} selected={s.key === l.status}>{s.label}</option>
                ))}
              </select>
            </div>
            <div class="a-field">
              <label for={`notes-${l.id}`}>یادداشت پیگیری</label>
              <textarea
                class="a-textarea"
                id={`notes-${l.id}`}
                name="notes"
                style="min-height:70px"
                placeholder="نتیجهٔ تماس، قرار بعدی، …">{l.notes ?? ''}</textarea>
            </div>
            <button class="a-btn a-btn-primary a-btn-sm" type="submit">ذخیره</button>
            <a class="a-btn a-btn-sm" href={`/admin/leads/${l.id}`}>پرونده و مسیر ↗</a>
            <span class={`a-badge a-badge-${l.status}`} style="margin-inline-start:8px">
              {statusLabel[l.status]}
            </span>
          </form>
        </div>
      </div>
    ))
  )}

  {result.pages > 1 && (
    <nav class="a-pages" aria-label="صفحه‌بندی">
      {Array.from({ length: result.pages }, (_, i) => i + 1).map((n) =>
        n === result.page
          ? <span class="is-current">{fa(n)}</span>
          : <a href={pageLink(n)}>{fa(n)}</a>,
      )}
    </nav>
  )}
</Admin>

<style>
  .lead-link { color: inherit; text-decoration: none; border-bottom: 1px dashed var(--a-line-2); }
  .lead-link:hover { color: var(--a-yellow); border-color: currentColor; }

  /* قراری که زمانش گذشته باید در فهرست به چشم بیاید، نه اینکه لای بقیهٔ
     سطرهای خاکستری گم شود. */
  .follow.is-due { color: var(--a-yellow); font-weight: 600; }

  /* برآوردی که خود کاربر در ماشین‌حساب دیده بود — عمداً از یادداشت تیم
     فروش جدا و کم‌رنگ‌تر است تا معلوم باشد این متن را کاربر تولید کرده. */
  .a-estimate {
    margin: 8px 0 0;
    padding: 8px 10px;
    border-inline-start: 2px solid var(--yellow);
    background: rgba(255, 196, 26, 0.05);
    border-radius: 6px;
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.8;
  }
  .a-estimate span {
    display: block;
    color: var(--faint);
    font-size: 11px;
    margin-bottom: 2px;
  }
</style>
