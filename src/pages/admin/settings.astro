---
import Admin from '../../layouts/Admin.astro';
import FieldView from '../../components/admin/FieldView.astro';
import { ROOT, parseForm } from '../../admin/fields';
import { SECTIONS, sectionByKey } from '../../admin/settingsSections';
import { getAllSettings, setSetting } from '../../server/repos/content';
import { resolveSiteSettings } from '../../server/repos/siteSettings';
import { DEFAULT_AREA_IMAGES, DEFAULT_PROMO_IMAGES } from '../../server/repos/slides';
import { listMedia } from '../../server/media/store';
import * as defaults from '../../data/siteContent';

export const prerender = false;

/**
 * ویرایش متن‌های سراسری سایت — با فرم، نه JSON.
 *
 * هر بخش در `src/admin/settingsSections.ts` تعریف شده؛ این صفحه فقط آن
 * تعریف را نمایش می‌دهد و ورودی را از همان راه برمی‌گرداند.
 */

const user = Astro.locals.user!;
let current = sectionByKey(Astro.url.searchParams.get('s') ?? '') ?? SECTIONS[0]!;

let error: string | null = null;
/** ورودی ردشده؛ فرم با همین دوباره نمایش داده می‌شود نه با مقدار ذخیره‌شده */
let rejected: unknown = undefined;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const section = sectionByKey(String(form.get('section') ?? ''));

  if (!section) {
    error = 'بخش نامعتبر است.';
  } else {
    current = section;
    const parsed = parseForm(section.root, form);
    const value = section.fromForm ? section.fromForm(parsed) : parsed;

    const problem = validate(section.key, value);
    if (problem) {
      error = problem;
      /* اگر فرم با مقدار ذخیره‌شده دوباره ساخته می‌شد، هر چیزی که ویراستار
         تایپ کرده بود از بین می‌رفت — ده تغییر به‌خاطر یک پیوند نادرست. */
      rejected = value;
    } else {
      await setSetting(section.key, value, user.id);
      /* پس از ذخیره به همان صفحه برمی‌گردیم با یک GET تازه. بدون این،
         بارگذاری دوبارهٔ صفحه فرم را دوباره ارسال می‌کرد. */
      return Astro.redirect(`/admin/settings?s=${section.key}&saved=1`);
    }
  }
}

/** بررسی‌هایی که اگر رد شوند، ذخیره نمی‌شود — چون سایت را خراب می‌کنند */
function validate(key: string, value: unknown): string | null {
  if (key === 'nav') {
    const bad = (value as { label: string; href: string }[]).find(
      (n) => !n.label || !/^(\/|https?:\/\/|#)/.test(n.href),
    );
    if (bad) {
      return `پیوند «${bad.label || 'بی‌نام'}» ناقص است. هر پیوند منو عنوان لازم دارد و نشانی‌اش باید با / یا http شروع شود.`;
    }
  }
  if (key === 'site') {
    const site = value as { name: string; phoneHref: string };
    if (!site.name) return 'نام شرکت نمی‌تواند خالی باشد — در عنوان همهٔ صفحات استفاده می‌شود.';
    if (site.phoneHref && !/^tel:\+?\d+$/.test(site.phoneHref)) {
      return 'پیوند تماس باید به شکل tel:03432521416 باشد — بدون فاصله و خط تیره.';
    }
  }
  return null;
}

/* ---------- مقدار فعلی هر بخش ---------- */

const [stored, media] = await Promise.all([getAllSettings(), listMedia()]);

/** تصویر پیش‌فرض را در ردیف‌هایی که هنوز تصویری انتخاب نکرده‌اند می‌نشاند،
    تا انتخابگر همان تصویری را نشان دهد که الان روی سایت است. */
function withImages<T extends Record<string, unknown>>(rows: T[], fallbacks: string[]): T[] {
  return rows.map((r, i) => ({ ...r, image: (r.image as string) || fallbacks[i] || '' }));
}

function currentValue(key: string): unknown {
  const merged = resolveSiteSettings(stored);
  switch (key) {
    case 'site':
    case 'portfolio':
    case 'nav':
    case 'stats':
    case 'timeline':
    case 'capabilities':
    case 'brands':
    case 'clients':
      return merged[key];
    case 'promoSlides':
      return withImages((stored.promoSlides as never) ?? [...defaults.promoSlides], DEFAULT_PROMO_IMAGES);
    case 'areas':
      return withImages((stored.areas as never) ?? defaults.areas, DEFAULT_AREA_IMAGES);
    case 'robots':
      return typeof stored.robots === 'string' ? stored.robots : 'User-agent: *\nAllow: /';
  }
  return stored[key];
}

const raw = rejected !== undefined ? rejected : currentValue(current.key);
const formValue = current.toForm ? current.toForm(raw) : raw;
const saved = Astro.url.searchParams.get('saved') === '1';
---
<Admin
  title="متن‌های سایت"
  lead="اطلاعات شرکت، منو، اسلایدها، آمار و بقیهٔ متن‌هایی که در چند صفحه تکرار می‌شوند. هر تغییر بلافاصله در سایت دیده می‌شود."
  roles={['admin', 'editor']}
>
  <div class="s-layout">
    <nav class="s-index" aria-label="بخش‌ها">
      {SECTIONS.map((s) => (
        <a href={`/admin/settings?s=${s.key}`} class:list={['s-index-item', s.key === current.key && 'is-current']}
           aria-current={s.key === current.key ? 'page' : undefined}>
          {s.title}
        </a>
      ))}
    </nav>

    <form class="a-card s-form" method="POST">
      <h2>{current.title}</h2>
      <p class="a-hint s-where">کجا دیده می‌شود: {current.where}</p>

      {saved && !error && <p class="a-msg a-msg-ok">ذخیره شد و روی سایت اعمال شد.</p>}
      {error && <p class="a-msg a-msg-err">{error} تغییرات ذخیره نشد.</p>}

      <input type="hidden" name="section" value={current.key} />
      <FieldView field={current.root} value={formValue} name={ROOT} media={media} />

      <div class="a-actions s-actions">
        <button class="a-btn a-btn-primary" type="submit">ذخیرهٔ «{current.title}»</button>
      </div>
    </form>
  </div>
</Admin>

<style>
  .s-layout { display: grid; grid-template-columns: 210px 1fr; gap: 20px; align-items: start; }
  .s-index {
    position: sticky; top: 16px;
    display: grid; gap: 2px;
    padding: 8px; border: 1px solid var(--a-line); border-radius: var(--a-r); background: var(--a-panel);
  }
  .s-index-item {
    padding: 8px 12px; border-radius: 7px;
    color: var(--a-muted); font-size: 14px; text-decoration: none;
  }
  .s-index-item:hover { color: var(--a-ink); background: rgba(255,255,255,.04); }
  .s-index-item.is-current { color: var(--a-ink); background: rgba(255,196,26,.1); box-shadow: inset -2px 0 0 var(--a-yellow); }
  .s-where { margin: -6px 0 18px !important; }
  .s-actions {
    position: sticky; bottom: 0;
    margin: 18px -18px -18px; padding: 14px 18px;
    background: var(--a-panel); border-top: 1px solid var(--a-line);
    border-radius: 0 0 var(--a-r) var(--a-r);
  }
  @media (max-width: 860px) {
    .s-layout { grid-template-columns: 1fr; }
    .s-index { position: static; grid-auto-flow: column; overflow-x: auto; }
    .s-index-item { white-space: nowrap; }
  }
</style>
