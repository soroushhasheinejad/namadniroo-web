---
import Admin from '../../layouts/Admin.astro';
import SettingsEditor from '../../components/admin/SettingsEditor.astro';
import { runSettingsPage } from '../../admin/settingsPage';

export const prerender = false;

/**
 * متن‌های سراسری سایت — با فرم، نه JSON.
 *
 * هر بخش در `src/admin/settingsSections.ts` تعریف شده؛ منطق مشترک با
 * «تنظیمات سئو» در `src/admin/settingsPage.ts` است.
 */
const result = await runSettingsPage(Astro, 'site', '/admin/settings');
if ('redirect' in result) return Astro.redirect(result.redirect);
---
<Admin
  title="متن‌های سایت"
  lead="اطلاعات شرکت، منو، بنرها، آمار و بقیهٔ متن‌هایی که در چند صفحه تکرار می‌شوند. هر تغییر بلافاصله در سایت دیده می‌شود."
  roles={['admin', 'editor']}
>
  <SettingsEditor view={result} basePath="/admin/settings" />
</Admin>
