---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Stats from '../components/Stats.astro';
import Icon from '../components/Icon.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import Timeline from '../components/Timeline.astro';
import PortfolioDownload from '../components/PortfolioDownload.astro';
import { getSiteSettings } from '../server/repos/siteSettings';
import { breadcrumbSchema } from '../utils';
import { getPageContent } from '../server/repos/pageContent';
import { aboutPage } from '../data/pages';
import { seoProps } from '../server/seo/pageSeo';

/* پویا، تا متنی که در پنل عوض می‌شود بلافاصله دیده شود. خواندن از کش
   درون‌حافظه‌ای است، پس هزینه‌اش ناچیز است. */
export const prerender = false;

const [{ capabilities, clients }, c] = await Promise.all([getSiteSettings(), getPageContent(aboutPage)]);

const pageSchema = breadcrumbSchema([{ name: 'درباره ما', href: '/about' }]);
const seo = await seoProps(c.seo);

---
<Base {...seo} schema={pageSchema}>
  <PageHero
    crumb="درباره ما"
    title={c.hero.title}
    lead={c.hero.lead}
  />

  <section class="about-sec">
    <div class="wrap about-intro is-solo">
      <div>
        {c.intro.lead && <p class="lead-lg">{c.intro.lead}</p>}
        {c.intro.body.map((para) => <p>{para}</p>)}
      </div>
    </div>
  </section>

  <PortfolioDownload />

  <Stats />

  <Timeline />

  <section class="about-sec">
    <div class="wrap">
      <header class="about-head">
        <p class="eyebrow">{c.capabilities.eyebrow}</p>
        <h2>{c.capabilities.title}</h2>
      </header>
      <div class="cap-grid">
        {capabilities.map((c) => (
          <div class="cap-card">
            <span class="cap-ic"><Icon name={c.icon} /></span>
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="about-sec alt">
    <div class="wrap">
      <header class="about-head">
        <p class="eyebrow">{c.brands.eyebrow}</p>
        <h2>{c.brands.title}</h2>
      </header>
      <BrandMarquee />
    </div>
  </section>

  <section class="about-sec">
    <div class="wrap">
      <header class="about-head">
        <p class="eyebrow">{c.clients.eyebrow}</p>
        <h2>{c.clients.title}</h2>
      </header>
      <div class="client-row">
        {clients.map((c) => <span class="client-chip">{c}</span>)}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2>{c.cta.title}</h2>
      <p>{c.cta.text}</p>
      <a class="btn btn-solid" href={c.cta.href}>{c.cta.label}</a>
    </div>
  </section>
</Base>
