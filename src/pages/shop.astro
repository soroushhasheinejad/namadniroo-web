---
import Base from '../layouts/Base.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import PageHero from '../components/PageHero.astro';
import ProductCard from '../components/ProductCard.astro';
import { breadcrumbSchema } from '../utils';
import { listProducts } from '../server/repos/content';
import { seoProps } from '../server/seo/pageSeo';
import { getPageContent } from '../server/repos/pageContent';
import { shopPage } from '../data/pages';
import { TYPES, liveFacets, productsOfType, shopSections } from '../data/shopTaxonomy';

/* محتوا از دیتابیس می‌آید، پس صفحه باید روی سرور ساخته شود تا تغییرات پنل
   بدون بیلد دوباره دیده شوند. لایهٔ کش باعث می‌شود این کار در عمل هزینهٔ
   کوئری نداشته باشد. */
export const prerender = false;

const products = await listProducts();

/* پدر به فرزند: هر نوع کالا با صفحه‌های نیتش، بالای فهرست کامل */
const live = liveFacets(products);
const types = TYPES.map((t) => ({ t, count: productsOfType(t, products).length }))
  .filter((x) => x.count > 0);

/* یک خط زیر نام هر دسته، تا کاشی‌ها هم‌قد بمانند و فهرست بلند صفحه‌های
   نیت (که فقط اینورتر دارد) کارت‌ها را نامتقارن نکند؛ آن صفحه‌ها پایین‌تر
   در یک ردیف «جست‌وجوهای پرتکرار» آمده‌اند. */
const TYPE_LEAD: Record<string, string> = {
  inverter: 'هیبرید، تک‌فاز، سه‌فاز تا نیروگاهی',
  panel: 'تک‌رو و دوطرفه',
  battery: 'ذخیره‌ساز یکپارچه و باتری لیتیومی',
  monitoring: 'دیتالاگر و پایش تولید',
  tools: 'کانکتور MC4 و ابزار اتصال',
};

/* فهرست کامل، دسته‌به‌دسته: اینورترها بر اساس کاربرد، بقیه بر اساس نوع */
const sections = shopSections(products);

const pageSchema = breadcrumbSchema([{ name: 'فروشگاه', href: '/shop' }]);
const c = await getPageContent(shopPage);
const seo = await seoProps(c.seo);

---
<Base {...seo} schema={pageSchema}>
  <PageHero
    crumb="فروشگاه"
    title={c.hero.title}
    lead={c.hero.lead}
  />

  <section class="shop-types" aria-label="دسته‌های فروشگاه">
    <div class="wrap">
      <div class="type-tiles">
        {types.map(({ t, count }) => (
          <a class="type-tile" href={`/shop/${t.slug}`} title={t.h1}>
            <span class="tile-count">{count.toLocaleString('fa-IR')} محصول</span>
            <span class="tile-name">{t.label}</span>
            <span class="tile-lead">{TYPE_LEAD[t.slug] ?? ''}</span>
            <span class="tile-go">مشاهده ←</span>
          </a>
        ))}
      </div>
      {live.length > 0 && (
        <div class="shop-popular">
          <span class="popular-label">جست‌وجوهای پرتکرار</span>
          <ul>{live.map((f) => <li><a href={`/shop/${f.type}/${f.slug}`}>{f.h1}</a></li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <nav class="shop-jump" aria-label="دسته‌های محصولات">
    <div class="wrap shop-jump-row">
      <span class="jump-label">اینورتر</span>
      {sections.map(({ section, items }, i) => (
        <>
          {i > 0 && section.id === 'panel' && <span class="jump-sep" aria-hidden="true"></span>}
          <a href={`#${section.id}`}>{section.short}<span>{items.length.toLocaleString('fa-IR')}</span></a>
        </>
      ))}
    </div>
  </nav>

  {sections.map(({ section, items }) => (
    <section class="shop-sec shop-group" id={section.id}>
      <div class="wrap">
        <header class="group-head">
          <div>
            <h2 class="group-title">{section.title}</h2>
            <p class="group-lead">{section.lead} · {items.length.toLocaleString('fa-IR')} محصول</p>
          </div>
          {section.href && <a class="group-more" href={section.href}>همهٔ {section.title} ←</a>}
        </header>
        <div class="shop-grid">
          {items.map((p) => <ProductCard p={p} />)}
        </div>
      </div>
    </section>
  ))}

  <RelatedArticles
    slugs={['inverter-role', 'how-panel-works', 'ongrid-offgrid']}
    title={c.related}
  />

  <section class="cta-band">
    <div class="wrap">
      <h2>{c.cta.title}</h2>
      <p>{c.cta.text}</p>
      <a class="btn btn-solid" href={c.cta.href}>{c.cta.label}</a>
    </div>
  </section>
</Base>

<style>
  .shop-types { padding: 34px 0 6px; }
  .type-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 14px; }
  .type-tile { display: flex; flex-direction: column; gap: 6px; padding: 18px 18px 16px; border: 1px solid var(--line); border-radius: var(--r); background: var(--bg-1); color: var(--ink); transition: border-color .2s, transform .2s; }
  .type-tile:hover { border-color: var(--yellow); transform: translateY(-2px); }
  .tile-count { color: var(--faint); font-size: 12.5px; }
  .tile-name { font-size: 21px; font-weight: 800; line-height: 1.35; }
  .tile-lead { color: var(--muted); font-size: 13.5px; line-height: 1.6; flex: 1; }
  .tile-go { color: var(--yellow); font-size: 13.5px; font-weight: 700; margin-top: 4px; }
  .shop-popular { display: flex; gap: 14px; align-items: baseline; margin-top: 18px; }
  .popular-label { flex: none; color: var(--faint); font-size: 13px; }
  .shop-popular ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
  .shop-popular li a { display: inline-block; padding: 4px 11px; border: 1px solid var(--line-2); border-radius: 999px; color: var(--muted); font-size: 13px; }
  .shop-popular li a:hover { color: var(--yellow); border-color: var(--yellow); }
  .shop-jump { position: sticky; top: 72px; z-index: 5; background: var(--bg); border-bottom: 1px solid var(--line); padding: 12px 0; margin-top: 18px; }
  .shop-jump-row { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
  .shop-jump-row::-webkit-scrollbar { display: none; }
  .shop-jump a { flex: none; display: inline-flex; align-items: center; gap: 6px; padding: 5px 11px; border: 1px solid var(--line-2); border-radius: 999px; color: var(--muted); font-size: 13px; white-space: nowrap; }
  .shop-jump-row { align-items: center; }
  .jump-label { flex: none; color: var(--faint); font-size: 13px; }
  .jump-sep { flex: none; width: 1px; height: 20px; background: var(--line-2); margin: 0 6px; }
  .shop-jump a span { color: var(--faint); font-size: 12px; }
  .shop-jump a:hover { color: var(--yellow); border-color: var(--yellow); }
  .shop-group { scroll-margin-top: 150px; padding: 40px 0 24px; }
  .group-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 18px; border-bottom: 1px solid var(--line); padding-bottom: 12px; }
  .group-title { margin: 0; font-size: 24px; font-weight: 800; color: var(--ink); }
  .group-lead { margin: 4px 0 0; color: var(--faint); font-size: 14px; }
  .group-more { flex: none; color: var(--yellow); font-size: 14px; font-weight: 700; }
  @media (max-width: 760px) { .shop-popular { flex-direction: column; gap: 8px; } }
  @media (max-width: 560px) { .type-tiles { grid-template-columns: repeat(2, 1fr); } .tile-name { font-size: 18px; } }
  @media (max-width: 560px) { .group-head { flex-direction: column; align-items: flex-start; } .group-title { font-size: 20px; } }
</style>
