---
import Base from '../layouts/Base.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import PageHero from '../components/PageHero.astro';
import FilterBar from '../components/FilterBar.astro';
import ProductCard from '../components/ProductCard.astro';
import { filters } from '../data/site';
import { breadcrumbSchema } from '../utils';
import { listProducts } from '../server/repos/content';
import { seoProps } from '../server/seo/pageSeo';
import { getPageContent } from '../server/repos/pageContent';
import { shopPage } from '../data/pages';

/* محتوا از دیتابیس می‌آید، پس صفحه باید روی سرور ساخته شود تا تغییرات پنل
   بدون بیلد دوباره دیده شوند. لایهٔ کش باعث می‌شود این کار در عمل هزینهٔ
   کوئری نداشته باشد. */
export const prerender = false;

const products = await listProducts();

const pageSchema = breadcrumbSchema([{ name: 'فروشگاه', href: '/shop' }]);
const seo = await seoProps((await getPageContent(shopPage)).seo);

---
<Base {...seo} schema={pageSchema}>
  <PageHero
    crumb="فروشگاه"
    title="تجهیزاتی که پروژه را می‌سازند"
    lead="اینورتر، پنل و ذخیره‌ساز از برندهای معتبر جهانی؛ برای خانه‌ها و صنایع، همراه با گارانتی و پشتیبانی فنی."
  />

  <section class="shop-sec">
    <div class="wrap">
      <FilterBar items={filters.products} label="فیلتر محصولات" />
      <div class="shop-grid">
        {products.map((p) => <ProductCard p={p} />)}
      </div>
    </div>
  </section>

  <RelatedArticles
    slugs={['inverter-role', 'how-panel-works', 'ongrid-offgrid']}
    title="راهنمای انتخاب تجهیزات"
  />

  <section class="cta-band">
    <div class="wrap">
      <h2>تجهیز موردنظرتان را پیدا نکردید؟</h2>
      <p>لیست کامل برندها و مدل‌ها را داریم؛ نیازتان را بگویید تا بهترین گزینه را پیشنهاد دهیم.</p>
      <a class="btn btn-solid" href="/#quote">درخواست مشاوره</a>
    </div>
  </section>
</Base>
