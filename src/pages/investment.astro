---
import Base from '../layouts/Base.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import PageHero from '../components/PageHero.astro';
import ProjectTile from '../components/ProjectTile.astro';
import { breadcrumbSchema, toLatinDigits } from '../utils';
import { listProjects } from '../server/repos/content';
import { seoProps } from '../server/seo/pageSeo';
import { getPageContent } from '../server/repos/pageContent';
import { investmentPage } from '../data/pages';

export const prerender = false;

const invested = (await listProjects()).filter((p) => p.cat === 'invest');

const totalMW = invested.reduce((sum, p) => sum + (parseFloat(toLatinDigits(p.capacity)) || 0), 0);
const faNum = (n: number) => String(n).replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[+d]);

const pageSchema = breadcrumbSchema([{ name: 'سرمایه‌گذاری', href: '/investment' }]);
const c = await getPageContent(investmentPage);
const seo = await seoProps(c.seo);

---
<Base {...seo} schema={pageSchema}>
  <PageHero
    crumb="سرمایه‌گذاری"
    title={c.hero.title}
    lead={c.hero.lead}
  >
    <div class="page-stats">
      <div class="page-stat"><b>{faNum(totalMW)}<i>MW</i></b><span>{c.stats.mwLabel}</span></div>
      <div class="page-stat"><b>{faNum(invested.length)}</b><span>{c.stats.countLabel}</span></div>
      {c.stats.thirdValue && (
        <div class="page-stat"><b>{c.stats.thirdValue}{c.stats.thirdUnit && <i>{c.stats.thirdUnit}</i>}</b><span>{c.stats.thirdCaption}</span></div>
      )}
    </div>
  </PageHero>

  <section class="about-sec">
    <div class="wrap about-intro">
      <div>
        {c.intro.lead && <p class="lead-lg">{c.intro.lead}</p>}
        {c.intro.body.map((para) => <p>{para}</p>)}
      </div>
      {c.intro.visual && <div class="about-visual"><b>{c.intro.visual}</b></div>}
    </div>
  </section>

  <section class="projects">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">{c.projects.eyebrow}</p>
        <h2 class="section-title">{c.projects.title}</h2>
      </header>
      <div class="proj-grid">
        {invested.map((p, i) => <ProjectTile p={p} large={i === 0} />)}
      </div>
    </div>
  </section>

  <section class="about-sec alt">
    <div class="wrap">
      <header class="about-head">
        <p class="eyebrow">{c.why.eyebrow}</p>
        <h2>{c.why.title}</h2>
      </header>
      <div class="cap-grid">
        {c.why.items.map((item) => (
          <div class="cap-card">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <RelatedArticles
    slugs={['solar-plant-profit', 'performance-ratio', 'solar-vs-generator']}
    title={c.related}
  />

  <section class="cta-band">
    <div class="wrap">
      <h2>{c.cta.title}</h2>
      <p>{c.cta.text}</p>
      <a class="btn btn-solid" href={c.cta.href}>{c.cta.label}</a>
    </div>
  </section>
</Base>
