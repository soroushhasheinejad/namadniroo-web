---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { breadcrumbSchema, faqSchema } from '../utils';
import { CONSTRUCTION_MONTHS, DEGRADATION, OM_RATE, ROOF_TILT_DEG, ROUTES, SOURCES, TARIFF, UPDATED_AT, YEARS, YIELD_BY_REGION } from '../data/solarModel';
import { fa } from '../utils';
import { seoProps } from '../server/seo/pageSeo';
import { getPageContent } from '../server/repos/pageContent';
import { calculatorPage } from '../data/pages';

export const prerender = false;

const regions = Object.entries(YIELD_BY_REGION);

const c = await getPageContent(calculatorPage);

/* فرض‌های مدل از خود ثابت‌های محاسبه ساخته می‌شوند نه از متن ثابت یا پنل —
   تا اگر روزی ضریبی در solarModel.ts عوض شد، توضیح صفحه با محاسبه یکی
   بماند. گرد کردن لازم است: ۰٫۰۰۷×۱۰۰ در جاوااسکریپت ۰٫۷۰۰۰۰۰۰۰۰۰۰۰۰۰۰۱ است. */
const pct = (rate: number) => fa(String(+(rate * 100).toFixed(3)));
const yields = Object.values(YIELD_BY_REGION).map((r) => r.kwhPerKw);
const months = Object.values(CONSTRUCTION_MONTHS);
const assumptions = [
  { label: 'تولید سالانه', text: `${fa(Math.min(...yields))} تا ${fa(Math.max(...yields))} کیلووات‌ساعت به ازای هر کیلووات، بر اساس پتانسیل فتوولتائیک منطقه (نه صرفاً تابش). افت گرما، غبار و اینورتر در آن لحاظ شده.` },
  { label: 'شیب پنل', text: `روی پشت‌بام، شیب استاندارد ${fa(ROOF_TILT_DEG)} درجه. سقف تخت یا شیب‌دار کمتر تولید می‌کند.` },
  { label: 'پست و خط انتقال', text: 'مبلغ ثابت است و با ظرفیت ضرب نمی‌شود؛ یک بار ساخته می‌شود و نیروگاه بزرگ‌تر آن را روی ظرفیت بیشتری سرشکن می‌کند.' },
  { label: 'نرخ بورس انرژی', text: `${fa(TARIFF.bourse.toLocaleString('en-US'))} تومان بر کیلووات‌ساعت، میانگین معاملات تابلوی سبز در ماه‌های اخیر. سقف تعرفهٔ تجدیدپذیر صنایع ${fa(TARIFF.bourseCeiling.toLocaleString('en-US'))} تومان است.` },
  { label: 'مدت ساخت', text: `${fa(Math.min(...months))} تا ${fa(Math.max(...months))} ماه بسته به اندازهٔ پروژه. بازگشت سرمایه هم بدون آن و هم با آن نوشته شده.` },
  { label: 'افت راندمان', text: `${pct(DEGRADATION)} درصد در سال.` },
  { label: 'نگه‌داری', text: `${pct(OM_RATE)} درصد سرمایه در سال.` },
  { label: 'افق محاسبه', text: `${fa(YEARS)} سال، هم‌اندازهٔ قرارداد خرید تضمینی.` },
  { label: 'تورم', text: 'لحاظ نشده. همه‌چیز به قیمت امروز است.' },
];


const pageSchema = [
  breadcrumbSchema([
    { name: 'سرمایه‌گذاری', href: '/investment' },
    { name: 'محاسبه سود نیروگاه خورشیدی', href: '/solar-calculator' },
  ]),
  faqSchema(c.faq),
  /* این صفحه یک ابزار است نه مقاله. WebApplication به گوگل همین را
     می‌گوید و شانس نمایش در نتایج «محاسبه…» را بالا می‌برد. */
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'ماشین‌حساب سود نیروگاه خورشیدی نماد نیرو',
    url: 'https://namadniroo.ir/solar-calculator',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
    inLanguage: 'fa-IR',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'IRR' },
    featureList: [
      'محاسبه سود نیروگاه خورشیدی',
      'محاسبه بازگشت سرمایه نیروگاه خورشیدی',
      'برآورد ظرفیت قابل احداث از روی سرمایه',
      'مقایسهٔ سه مسیر فروش برق: ساتبا، بورس انرژی و خودمصرفی صنعتی',
    ],
    publisher: { '@id': 'https://namadniroo.ir/#organization' },
  },
];
const seo = await seoProps(c.seo);

---
<Base {...seo}
  schema={pageSchema}
>
  <PageHero
    crumb="برآورد سرمایه‌گذاری"
    title={c.hero.title}
    lead={c.hero.lead}
  />

  <div class="wrap">
    <p class="approx-banner">
      <b>{c.disclaimer.lead}</b>
      {c.disclaimer.text}
    </p>
    <p class="calc-guide-link">
      اولین بار است از این صفحه استفاده می‌کنید؟
      <a href="/magazine/solar-calculator-guide">راهنمای ماشین‌حساب</a>
      توضیح می‌دهد هر ورودی چه اثری بر نتیجه دارد و خروجی را چطور بخوانید. اگر
      دنبال عددهای آمادهٔ هر ظرفیت هستید،
      <a href="/magazine/solar-plant-profit">سود نیروگاه خورشیدی چقدر است</a>
      جدول کامل ۱۴۰۵ را دارد.
    </p>
  </div>

  <section class="calc">
    <div class="wrap calc-grid">
      <form class="calc-form" id="calcForm" novalidate>
        <h2 class="calc-h">فرض‌های شما</h2>

        <div class="field">
          <label for="c-investment">سرمایهٔ موردنظر (تومان)</label>
          <input id="c-investment" type="text" inputmode="numeric" dir="rtl" value="۷۰٬۰۰۰٬۰۰۰٬۰۰۰" />
          <span class="field-hint" id="investmentWords">۷۰ میلیارد تومان</span>
        </div>

        <div class="presets" id="presets">
          <button type="button" data-amount="1000000000">۱ میلیارد</button>
          <button type="button" data-amount="5000000000">۵ میلیارد</button>
          <button type="button" data-amount="10000000000">۱۰ میلیارد</button>
          <button type="button" data-amount="70000000000">۷۰ میلیارد</button>
          <button type="button" data-amount="200000000000">۲۰۰ میلیارد</button>
        </div>

        <div class="field">
          <label for="c-mount">نوع نصب</label>
          <select id="c-mount">
            <option value="ground">زمینی — نیروگاه مستقل روی زمین</option>
            <option value="roof">پشت‌بام — روی سوله یا ساختمان موجود</option>
          </select>
          <span class="field-hint" id="mountHint"></span>
        </div>

        <div class="field">
          <label for="c-region">منطقه (بر اساس پتانسیل فتوولتائیک)</label>
          <select id="c-region">
            {regions.map(([key, r]) => (
              <option value={key} selected={key === 'high'}>{r.label}</option>
            ))}
          </select>
        </div>

        <details class="advanced">
          <summary>فرض‌های پیشرفته</summary>
          <p class="adv-note">
            اگر استعلام قیمت دارید، این‌ها را با عدد خودتان عوض کنید — نتیجه بلافاصله به‌روز می‌شود.
          </p>

          <div class="field">
            <label for="c-equip">هزینهٔ تجهیزات و نصب (میلیون تومان بر کیلووات)</label>
            <input id="c-equip" type="number" step="0.5" min="1" dir="ltr" value="35" />
          </div>

          <div class="field" id="landField">
            <label for="c-land">زمین و محوطه‌سازی (میلیون تومان بر کیلووات)</label>
            <input id="c-land" type="number" step="0.5" min="0" dir="ltr" value="15" />
            <span class="field-hint">با ظرفیت بزرگ می‌شود، چون مساحت لازم بزرگ می‌شود.</span>
          </div>

          <div class="field" id="gridField">
            <label for="c-grid">پست و خط انتقال (میلیارد تومان)</label>
            <input id="c-grid" type="number" step="1" min="0" dir="ltr" value="20" />
            <span class="field-hint">
              مبلغ ثابت است و با ظرفیت ضرب نمی‌شود؛ به فاصله تا شبکه و سطح ولتاژ بستگی دارد.
            </span>
          </div>

          <div class="field">
            <label for="c-om">نگه‌داری سالانه (درصد سرمایه)</label>
            <input id="c-om" type="number" step="0.1" min="0" dir="ltr" value="1.5" />
          </div>
        </details>
      </form>

      <div class="calc-out" id="calcOut">
        <h2 class="calc-h">نتیجهٔ تقریبی</h2>

        <div class="out-top">
          <div class="out-big">
            <span class="out-label">ظرفیت قابل احداث</span>
            <b id="outCapacity">—</b>
            <span class="out-range" id="outCapacityRange"></span>
          </div>
          <div class="out-big">
            <span class="out-label">تولید سال اول</span>
            <b id="outProduction">—</b>
            <span class="out-range">کیلووات‌ساعت در سال</span>
          </div>
          <div class="out-big">
            <span class="out-label">زمین یا سقف لازم</span>
            <b id="outArea">—</b>
            <span class="out-range" id="outAreaNote"></span>
          </div>
        </div>

        <p class="out-note" id="outNote" hidden></p>

        <h3 class="out-h">سرمایه صرف چه می‌شود؟</h3>
        <div class="capex-bar" id="capexBar"></div>

        <h3 class="out-h">سود نیروگاه خورشیدی، به تفکیک روش فروش برق</h3>
        <p class="out-sub">بازگشت سرمایه از روز اتصال به شبکه حساب شده است — مدت ساخت جدا آمده.</p>
        <div class="route-table" id="routeTable"></div>
        {c.resultsFoot && <p class="out-foot">{c.resultsFoot}</p>}

        <div class="pdf-box">
          <div class="pdf-copy">
            <b>{c.pdf.title}</b>
            <p>{c.pdf.text}</p>
          </div>

          <form class="pdf-form" id="pdfForm" novalidate>
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp-field" aria-hidden="true" />
            <div class="field-row">
              <div class="field">
                <label for="p-name">نام و نام خانوادگی</label>
                <input id="p-name" name="name" type="text" autocomplete="name" required />
              </div>
              <div class="field">
                <label for="p-phone">شمارهٔ تماس</label>
                <input id="p-phone" name="phone" type="tel" inputmode="tel" dir="ltr" autocomplete="tel" required />
              </div>
            </div>
            <button type="submit" class="btn btn-solid btn-block" id="pdfBtn">{c.pdf.button}</button>
            <p class="pdf-note" id="pdfNote">{c.pdf.note}</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="about-sec alt">
    <div class="wrap">
      <header class="about-head">
        <p class="eyebrow">{c.routesHead.eyebrow}</p>
        <h2>{c.routesHead.title}</h2>
      </header>
      <div class="cap-grid">
        {ROUTES.map((r) => (
          <div class="cap-card route-card">
            <h3>{r.title}</h3>
            <p class="route-tariff">{r.tariffLabel}</p>
            <p>{r.summary}</p>
            <ul class="route-pros">
              {r.pros.map((p) => <li>{p}</li>)}
            </ul>
            <ul class="route-cons">
              {r.cons.map((c) => <li>{c}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="about-sec">
    <div class="wrap assumptions">
      <header class="about-head">
        <p class="eyebrow">{c.transparency.eyebrow}</p>
        <h2>{c.transparency.title}</h2>
      </header>

      <div class="assume-grid">
        <div>
          <h3>فرض‌های مدل</h3>
          <ul class="assume-list">
            {assumptions.map((a) => <li><b>{a.label}:</b> {a.text}</li>)}
          </ul>
        </div>

        <div>
          <h3>{c.transparency.whyTitle}</h3>
          {c.transparency.whyBody.map((para) => <p>{para}</p>)}
        </div>
      </div>

      <h3 class="src-h">منابع — آخرین به‌روزرسانی: {UPDATED_AT}</h3>
      <ul class="src-list">
        {SOURCES.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer nofollow">{s.label}</a>
            <span>{s.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="about-sec alt">
    <div class="wrap">
      <header class="about-head">
        <h2>محاسبه سود نیروگاه خورشیدی؛ بعد از این صفحه</h2>
      </header>
      <p class="calc-more">
        خروجی این ابزار یک برآورد از سود نیروگاه خورشیدی بر پایهٔ فرض‌های بالاست.
        برای رفتن سراغ عددهای دقیق‌تر:
      </p>
      <ul class="calc-more-list">
        <li>
          <a href="/magazine/solar-plant-profit">سود نیروگاه خورشیدی چقدر است؟</a>
          — جدول سود خالص سالانه و بیست‌ساله برای هر ظرفیت، حاشیه سود و اثر منطقه.
        </li>
        <li>
          <a href="/magazine/payback-calculation">محاسبه بازگشت سرمایه</a>
          — فرمول‌ها با مثال عددی کامل و اشتباه‌هایی که برآورد را خوش‌بینانه می‌کنند.
        </li>
        <li>
          <a href="/magazine/solar-income-1405">درآمد نیروگاه خورشیدی در ۱۴۰۵</a>
          — تفاوت درآمد و سود، و جدول درآمد به تفکیک مسیر فروش.
        </li>
      </ul>
    </div>
  </section>

  <section class="calc-cta">
    <div class="wrap">
      <h2>{c.cta.title}</h2>
      <p>{c.cta.text}</p>
      <a class="btn btn-solid" id="ctaLink" href="/#quote">{c.cta.label}</a>
    </div>
  </section>
</Base>

<script>
  import {
    EQUIPMENT_COST,
    GRID_COST,
    LAND_COST,
    ROUTES,
    TARIFF,
    YIELD_BY_REGION,
    calculate,
    type Assumptions,
    type Mount,
  } from '../data/solarModel';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  /* رویدادهای قیف ماشین‌حساب.
     تابع ردیاب را کامپوننت Analytics روی window می‌گذارد؛ اگر به هر دلیل
     بالا نیامده باشد، این‌ها بی‌صدا رد می‌شوند و ماشین‌حساب کار خودش را
     می‌کند — آمار هرگز نباید ابزار را زمین بزند. */
  const track = (type: string, props?: Record<string, string | number | boolean>) =>
    (window as any).nnTrack?.(type, props);
  const trackOnce = (type: string, props?: Record<string, string | number | boolean>) =>
    (window as any).nnTrackOnce?.(type, props);

  const form = $<HTMLFormElement>('calcForm');
  if (form) {
    const investmentInput = $<HTMLInputElement>('c-investment');
    const mountSelect = $<HTMLSelectElement>('c-mount');
    const regionSelect = $<HTMLSelectElement>('c-region');
    const equipInput = $<HTMLInputElement>('c-equip');
    const landInput = $<HTMLInputElement>('c-land');
    const gridInput = $<HTMLInputElement>('c-grid');
    const omInput = $<HTMLInputElement>('c-om');
    const landField = $<HTMLDivElement>('landField');
    const gridField = $<HTMLDivElement>('gridField');

    /* جداکنندهٔ هزارگان و اعشار هم فارسی می‌شود، وگرنه عدد نیمه‌فارسی
       می‌ماند. معکوسش هنگام خواندن ورودی لازم است. */
    const fa = (v: string | number) =>
      String(v)
        .replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[+d]!)
        .replace(/,/g, '٬')
        .replace(/\./g, '٫');
    const latin = (v: string) =>
      v
        .replace(/[۰-۹]/g, (d) => String('۰۱۲۳۴۵۶۷۸۹'.indexOf(d)))
        .replace(/٬/g, ',')
        .replace(/٫/g, '.');

    /** عدد بزرگ را به «میلیارد/میلیون تومان» می‌نویسد — خواندن ۱۲ رقم پشت‌سرهم سخت است */
    const toman = (n: number): string => {
      if (n >= 1_000_000_000_000) return `${fa((n / 1_000_000_000_000).toFixed(1))} هزار میلیارد`;
      if (n >= 1_000_000_000) return `${fa((n / 1_000_000_000).toFixed(n < 10_000_000_000 ? 1 : 0))} میلیارد`;
      if (n >= 1_000_000) return `${fa(Math.round(n / 1_000_000))} میلیون`;
      return fa(Math.round(n).toLocaleString('en-US'));
    };

    const grouped = (n: number) => Math.round(n).toLocaleString('en-US');

    const readInvestment = (): number => {
      const raw = latin(investmentInput.value).replace(/[^\d]/g, '');
      return Number(raw) || 0;
    };

    const assumptionsFrom = (): Assumptions => ({
      equipmentCostPerKw: Number(equipInput.value) * 1_000_000,
      landCostPerKw: Number(landInput.value) * 1_000_000,
      gridCost: Number(gridInput.value) * 1_000_000_000,
      yieldPerKw: YIELD_BY_REGION[regionSelect.value]!.kwhPerKw,
      mount: mountSelect.value as Mount,
      omRate: Number(omInput.value) / 100,
      degradation: 0.007,
      years: 20,
    });

    /** ظرفیت را با واحد مناسب می‌نویسد */
    const capacity = (kw: number) =>
      kw >= 1000 ? `${fa((kw / 1000).toFixed(2))} مگاوات` : `${fa(Math.round(kw))} کیلووات`;

    const area = (m2: number) =>
      m2 >= 10_000 ? `${fa((m2 / 10_000).toFixed(1))} هکتار` : `${fa(Math.round(m2))} مترمربع`;

    const render = () => {
      const investment = readInvestment();
      const base = assumptionsFrom();

      $('investmentWords').textContent = investment ? `${toman(investment)} تومان` : '—';

      // هزینهٔ محوطه فقط برای نصب زمینی معنا دارد
      landField.hidden = base.mount === 'roof';
      gridField.hidden = base.mount === 'roof';

      /* شیب پنل روی تولید اثر مستقیم دارد: برآورد پشت‌بامی بر مبنای شیب
         استاندارد ۳۰ درجه است و سقف تخت یا شیب‌دار کمتر تولید می‌کند. */
      $('mountHint').textContent =
        base.mount === 'roof'
          ? 'برآورد بر مبنای شیب استاندارد ۳۰ درجه است؛ روی سقف تخت یا شیب‌دار کمتر می‌شود.'
          : 'پنل‌ها روی سازهٔ ثابت با شیب بهینه فرض شده‌اند.';

      const blank = (message: string) => {
        $('outCapacity').textContent = '—';
        $('outCapacityRange').textContent = '';
        $('outProduction').textContent = '—';
        $('outArea').textContent = '—';
        $('routeTable').innerHTML = '';
        $('capexBar').innerHTML = '';
        const note = $('outNote');
        note.innerHTML = message;
        note.hidden = false;
        $('toRoof')?.addEventListener('click', () => {
          mountSelect.value = 'roof';
          render();
        });
      };

      if (investment < 50_000_000) {
        blank('برای دیدن برآورد، مبلغ سرمایه را وارد کنید.');
        return;
      }

      const mid = calculate(investment, base);

      /* پست و خط انتقال پیش از هر پنلی ساخته می‌شوند. اگر سرمایه به آن
         نرسد، نشان‌دادن ظرفیت صفر گیج‌کننده است؛ به‌جایش می‌گوییم چقدر کم
         است و راه عملی را پیشنهاد می‌دهیم. */
      if (mid.belowGridCost) {
        blank(
          `پست و خط انتقال به‌تنهایی حدود ${toman(base.gridCost)} تومان هزینه دارد و ` +
            `پیش از نصب پنل‌ها ساخته می‌شود. با این سرمایه، نیروگاه زمینیِ مستقل شکل نمی‌گیرد — ` +
            `اگر سقف یا سولهٔ موجود دارید، نصب پشت‌بامی با همین مبلغ جواب می‌دهد؛ ` +
            `و اگر امکان اتصال به شبکهٔ موجود را دارید، رقم پست و خط را در ` +
            `«فرض‌های پیشرفته» کم کنید. ` +
            `<button type="button" class="note-action" id="toRoof">محاسبه به‌صورت پشت‌بامی</button>`,
        );
        return;
      }

      $('outNote').hidden = true;

      /* بازه از کم‌ترین و بیش‌ترین هزینهٔ منتشرشده ساخته می‌شود، نه از یک
         درصد دلخواه — تا بازه واقعاً بازتاب اختلاف منابع باشد. */
      const scale = mid.scale;
      const cheap = calculate(investment, {
        ...base,
        equipmentCostPerKw: EQUIPMENT_COST[scale].min,
        landCostPerKw: LAND_COST.min,
        gridCost: GRID_COST.min,
      });
      const pricey = calculate(investment, {
        ...base,
        equipmentCostPerKw: EQUIPMENT_COST[scale].max,
        landCostPerKw: LAND_COST.max,
        gridCost: GRID_COST.max,
      });

      $('outCapacity').textContent = `حدود ${capacity(mid.capacityKw)}`;
      /* اگر گران‌ترین حالت اصلاً جواب ندهد (پست و خط از کل سرمایه بیشتر
         شود)، نوشتن «۰ کیلووات» در بازه گمراه‌کننده است. */
      $('outCapacityRange').textContent = pricey.belowGridCost
        ? `در گران‌ترین حالت، سرمایه به پست و خط نمی‌رسد`
        : `بازه: ${capacity(pricey.capacityKw)} تا ${capacity(cheap.capacityKw)}`;

      /* تفکیک سرمایه مهم‌ترین چیزی است که سرمایه‌گذار زمینی باید ببیند:
         سهم پست و خط انتقال در پروژهٔ کوچک می‌تواند از خود تجهیزات
         بیشتر باشد، و همین است که پروژهٔ کوچکِ زمینی را بی‌صرفه می‌کند. */
      const parts = [
        { label: 'تجهیزات و نصب', value: mid.capex.equipment, cls: 'cx-equip' },
        { label: 'زمین و محوطه', value: mid.capex.land, cls: 'cx-land' },
        { label: 'پست و خط انتقال', value: mid.capex.grid, cls: 'cx-grid' },
      ].filter((p) => p.value > 0);

      $('capexBar').innerHTML = `
        <div class="cx-track">
          ${parts
            .map(
              (p) =>
                `<span class="cx-seg ${p.cls}" style="width:${((p.value / investment) * 100).toFixed(1)}%"></span>`,
            )
            .join('')}
        </div>
        <ul class="cx-legend">
          ${parts
            .map(
              (p) =>
                `<li><i class="${p.cls}"></i>${p.label}<b>${toman(p.value)} تومان</b>
                 <span>${fa(Math.round((p.value / investment) * 100))}٪</span></li>`,
            )
            .join('')}
        </ul>`;
      $('outProduction').textContent = `حدود ${fa(grouped(mid.firstYearProductionKwh))}`;
      $('outArea').textContent = `حدود ${area(mid.areaM2)}`;
      $('outAreaNote').textContent =
        base.mount === 'ground' ? 'زمین، شامل فاصلهٔ بین ردیف‌ها' : 'سطح بدون سایه روی پشت‌بام';

      const rows = ROUTES.map((route) => {
        const tariff =
          route.key === 'satba' ? TARIFF.satba[mid.scale] : TARIFF[route.key];

        /* بالای یک مگاوات نرخ مصوب خرید تضمینی وجود ندارد؛ به‌جای نشان‌دادن
           عددی که مصوبه‌ای پشتش نیست، همین را می‌گوییم. */
        if (tariff === null) {
          return `
            <div class="route-row">
              <div class="route-name">
                <b>${route.title}</b>
                <span>برای این ظرفیت نرخ مصوب ندارد</span>
              </div>
              <div class="route-nums route-na">
                مصوبهٔ ۱۴۰۵ تا سقف یک مگاوات نرخ دارد. نیروگاه بزرگ‌تر از
                راه بورس انرژی یا مزایده قیمت‌گذاری می‌شود.
              </div>
            </div>`;
        }

        const r = calculate(investment, { ...base, tariff });
        /* دو عدد نشان داده می‌شود چون سرمایه‌گذار با روز پرداخت پول
           کار دارد، نه با روز سنکرون: نیروگاه تا وقتی ساخته می‌شود
           درآمدی ندارد ولی پول خوابیده است. */
        const payback = r.paybackYears
          ? `${fa(r.paybackYears.toFixed(1))} سال`
          : 'بیش از ۲۰ سال';
        const paybackNote = r.paybackWithBuildYears
          ? `<span class="route-sub">با ${fa(r.constructionMonths)} ماه ساخت: ${fa(
              r.paybackWithBuildYears.toFixed(1),
            )} سال</span>`
          : '';

        return `
          <div class="route-row">
            <div class="route-name">
              <b>${route.title}</b>
              <span>${fa(grouped(tariff))} تومان بر کیلووات‌ساعت</span>
            </div>
            <div class="route-nums">
              <div><span>سود خالص سال اول</span><b>${toman(r.firstYearNet)} تومان</b></div>
              <div><span>بازگشت سرمایه<i>بدون احتساب زمان ساخت</i></span><b>${payback}</b>${paybackNote}</div>
              <div><span>سود خالص ۲۰ ساله</span><b>${toman(r.totalNet)} تومان</b></div>
            </div>
          </div>`;
      });

      $('routeTable').innerHTML = rows.join('');

      /* لینک دعوت به مشاوره، ظرفیت برآوردشده را با خودش می‌برد تا کارشناس
         بداند کاربر دربارهٔ چه ابعادی پرسیده است. */
      $<HTMLAnchorElement>('ctaLink').href =
        `/contact?capacity=${encodeURIComponent(capacity(mid.capacityKw))}`;

      /* رسیدن به یک برآورد معتبر، مهم‌ترین نقطهٔ قیف است: از اینجا به بعد
         کاربر عددی از ما دارد. ظرفیت را هم می‌فرستیم تا در گزارش معلوم
         باشد سایت بیشتر چه اندازه پروژه‌ای جذب می‌کند. */
      trackOnce('calc_result', {
        kw: Math.round(mid.capacityKw),
        investment: Math.round(investment / 1_000_000),
        mount: base.mount,
        region: regionSelect.value,
      });
    };

    /* ---------- دریافت PDF ---------- */

    /** آدرس برگهٔ چاپی با همان فرض‌هایی که کاربر جلوی چشمش دارد */
    const reportUrl = (print: boolean) => {
      const a = assumptionsFrom();
      const p = new URLSearchParams({
        investment: String(readInvestment()),
        mount: a.mount,
        region: regionSelect.value,
        equip: equipInput.value,
        land: landInput.value,
        grid: gridInput.value,
        om: omInput.value,
      });
      if (print) p.set('print', '1');
      return `/solar-calculator/report?${p}`;
    };

    /** خلاصهٔ یک‌خطی برآورد، برای اینکه کارشناس بداند کاربر چه دیده بود */
    const estimateSummary = () => {
      const investment = readInvestment();
      const r = calculate(investment, assumptionsFrom());
      const mount = assumptionsFrom().mount === 'ground' ? 'زمینی' : 'پشت‌بام';
      return `سرمایه ${toman(investment)} تومان · ${mount} · ${YIELD_BY_REGION[regionSelect.value]!.label} · ظرفیت حدود ${capacity(r.capacityKw)} · تولید سال اول حدود ${fa(grouped(r.firstYearProductionKwh))} kWh`;
    };

    const pdfForm = $<HTMLFormElement>('pdfForm');
    const pdfBtn = $<HTMLButtonElement>('pdfBtn');
    const pdfNote = $('pdfNote');

    pdfForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!pdfForm.checkValidity()) { pdfForm.reportValidity(); return; }

      /* پنجره را همین حالا و داخل خود رویداد کلیک باز می‌کنیم. اگر بعد از
         await باز شود، مرورگر آن را پنجرهٔ ناخواسته می‌بیند و می‌بندد. */
      const tab = window.open('', '_blank');

      pdfBtn.disabled = true;
      pdfNote.textContent = 'در حال آماده‌سازی…';

      const data = Object.fromEntries(new FormData(pdfForm).entries());

      try {
        const res = await fetch('/api/quote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            ...data,
            area: 'سرمایه‌گذاری و احداث نیروگاه',
            capacity: capacity(calculate(readInvestment(), assumptionsFrom()).capacityKw),
            source: location.pathname,
            estimate: estimateSummary(),
          }),
        });
        const out = await res.json();

        if (out.success) {
          track('calc_report', {
            kw: Math.round(calculate(readInvestment(), assumptionsFrom()).capacityKw),
          });
          pdfNote.textContent = 'آماده شد. اگر برگه باز نشد، از دکمهٔ زیر استفاده کنید.';
          pdfForm.insertAdjacentHTML(
            'beforeend',
            `<a class="pdf-fallback" href="${reportUrl(false)}" target="_blank" rel="noopener">باز کردن برگهٔ برآورد</a>`,
          );
          if (tab) tab.location.href = reportUrl(true);
          else window.open(reportUrl(true), '_blank');
        } else {
          tab?.close();
          pdfNote.textContent = out.message || 'ارسال با خطا مواجه شد؛ لطفاً دوباره تلاش کنید.';
        }
      } catch {
        tab?.close();
        pdfNote.textContent = 'ارتباط برقرار نشد؛ لطفاً دوباره تلاش کنید.';
      } finally {
        pdfBtn.disabled = false;
      }
    });

    /* شروع کار با ماشین‌حساب = اولین باری که کاربر واقعاً چیزی را دست
       می‌زند، نه باز شدن صفحه. باز شدن صفحه همان بازدید است و جداگانه
       ثبت می‌شود؛ اگر این دو یکی شمرده شوند، قیف هیچ نشتی نشان نمی‌دهد. */
    form.addEventListener('input', () => trackOnce('calc_start'), { once: false });
    form.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('button[data-amount]')) trackOnce('calc_start');
    });

    /** مبلغ را موقع تایپ سه‌رقم‌سه‌رقم جدا می‌کند */
    investmentInput.addEventListener('input', () => {
      const pos = investmentInput.selectionStart ?? 0;
      const before = investmentInput.value.length;
      const n = readInvestment();
      investmentInput.value = n ? fa(grouped(n)) : '';
      const after = investmentInput.value.length;
      investmentInput.setSelectionRange(pos + (after - before), pos + (after - before));
      render();
    });

    for (const el of [mountSelect, regionSelect, equipInput, landInput, gridInput, omInput]) {
      el.addEventListener('input', render);
      // انتخابگرها در بعضی مرورگرها فقط change می‌دهند، نه input
      el.addEventListener('change', render);
    }

    /* پیش‌فرض هزینهٔ تجهیزات با مقیاس عوض می‌شود، مگر کاربر خودش دست برده
       باشد — در آن صورت به عددش دست نمی‌زنیم. */
    let equipTouched = false;
    equipInput.addEventListener('input', () => { equipTouched = true; });

    $('presets').addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button[data-amount]');
      if (!btn) return;
      investmentInput.value = fa(grouped(Number(btn.getAttribute('data-amount'))));
      if (!equipTouched) {
        const kw = Number(btn.getAttribute("data-amount")) / 35_000_000;
        const scale = kw < 200 ? 'small' : kw < 1000 ? 'commercial' : 'utility';
        equipInput.value = String(EQUIPMENT_COST[scale].typical / 1_000_000);
      }
      render();
    });

    /* پاسخ‌هایی که کاربر در پیش‌نمایش صفحهٔ اصلی داده بود (?amount=&region=)
       همین‌جا اعمال می‌شود تا مجبور نباشد دوباره انتخاب کند. سرمایه از
       همان مسیر دکمه‌های پیش‌فرض می‌رود تا هزینهٔ تجهیزات هم با مقیاس جور
       شود. مقدار نامعتبر نادیده گرفته می‌شود. */
    const params = new URLSearchParams(location.search);
    const region = params.get('region');
    if (region && [...regionSelect.options].some((o) => o.value === region)) {
      regionSelect.value = region;
    }
    const amount = Number(params.get('amount'));
    if (Number.isFinite(amount) && amount >= 100_000_000 && amount <= 10_000_000_000_000) {
      investmentInput.value = fa(grouped(amount));
      if (!equipTouched) {
        const kw = amount / 35_000_000;
        const scale = kw < 200 ? 'small' : kw < 1000 ? 'commercial' : 'utility';
        equipInput.value = String(EQUIPMENT_COST[scale].typical / 1_000_000);
      }
    }

    render();
  }
</script>

