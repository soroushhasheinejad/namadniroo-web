---
import Base from '../layouts/Base.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import ModuleAnatomy from '../components/ModuleAnatomy.astro';
import { fa } from '../utils';
import { ae } from '../data/aesolar';
import { fillTokens, markedParts } from '../lib/text';
import { breadcrumbSchema, faqSchema } from '../utils';
import { seoProps } from '../server/seo/pageSeo';
import { getPageContent } from '../server/repos/pageContent';
import { aeSolarPage } from '../data/pages';
import { listProducts } from '../server/repos/content';
import { aeModels } from '../data/aesolarModels';

/* پویا، تا متنی که در پنل عوض می‌شود بلافاصله دیده شود. خواندن از کش
   درون‌حافظه‌ای است، پس هزینه‌اش ناچیز است. */
export const prerender = false;

const c = await getPageContent(aeSolarPage);
const seo = await seoProps(c.seo);

/* پنل‌های AE Solar فروشگاه، تا این صفحه به صفحهٔ هر محصول پیوند بدهد و
   برعکس. برند در دیتابیس با &nbsp; ذخیره شده، پس فاصله‌ها کنار می‌روند. */
const aeProducts = (await listProducts().catch(() => []))
  .filter((p) => p.kind === 'panel' && /^AESOLAR$/i.test(p.brand.replace(/&nbsp;|\s/g, '')));

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://namadniroo.ir/ae-solar#webpage',
    url: 'https://namadniroo.ir/ae-solar',
    name: c.seo.title,
    inLanguage: 'fa-IR',
    /* صفحه دربارهٔ برند است و ناشرش همان سازمانی که Base معرفی می‌کند */
    about: {
      '@type': 'Brand',
      name: 'AE Solar',
      alternateName: ['AE SOLAR', 'ای ای سولار'],
      url: 'https://ae-solar.com',
    },
    publisher: { '@id': 'https://namadniroo.ir/#organization' },
  },
  breadcrumbSchema([{ name: 'AE Solar', href: '/ae-solar' }]),
  // همان پرسش‌هایی که روی صفحه است
  faqSchema(c.faq),
];

---
<Base {...seo}
  schema={pageSchema}
>
  <div class="ae-page">

    <!-- ===== سربرگ ===== -->
    <section class="ae-hero">
      <div class="wrap">
        {c.hero.badge && <span class="ae-badge">{c.hero.badge}</span>}
        <h1 class="ae-title">
          {c.hero.line1}<br />
          <span class="red">{c.hero.line2}</span><br />
          <span class="dim">{c.hero.line3}</span>
        </h1>
        <p class="ae-lead">{fillTokens(c.hero.lead, { since: ae.since })}</p>
        <div class="ae-hero-cta">
          <a class="btn btn-solid" href={c.hero.primaryHref}>{c.hero.primaryLabel}</a>
          <a class="btn btn-ghost" href="#series">{c.hero.secondaryLabel}</a>
        </div>
      </div>
    </section>

    <!-- ===== آمار ===== -->
    <section class="ae-stats" aria-label="AE Solar در یک نگاه">
      {c.stats.map((s) => (
        <div class="ae-stat">
          <b>{s.value}{s.plus && <i>+</i>}{s.unit && <i>{s.unit}</i>}</b>
          <span>{s.label}</span>
        </div>
      ))}
    </section>

    <!-- ===== امضا: کالبدشکافی ماژول ===== -->
    <section class="ae-sec">
      <div class="wrap">
        <header class="ae-head">
          <p class="ae-kicker">{c.anatomyHead.kicker}</p>
          <h2 class="ae-h2">
            {markedParts(c.anatomyHead.line1).map((part) => (part.marked ? <span class="red">{part.text}</span> : part.text))}<br />
            <em>{c.anatomyHead.line2}</em>
          </h2>
          {c.anatomyHead.sub && <p class="ae-sub">{c.anatomyHead.sub}</p>}
        </header>
        <ModuleAnatomy />
      </div>
    </section>

    <!-- ===== سری‌ها ===== -->
    <section class="ae-sec alt" id="series">
      <div class="wrap">
        <header class="ae-head">
          <p class="ae-kicker">{c.seriesHead.kicker}</p>
          <h2 class="ae-h2">
            {markedParts(c.seriesHead.line1).map((part) => (part.marked ? <span class="red">{part.text}</span> : part.text))}<br />
            <em>{c.seriesHead.line2}</em>
          </h2>
          {c.seriesHead.sub && <p class="ae-sub">{c.seriesHead.sub}</p>}
        </header>

        <div class="series-grid">
          {c.series.map((s) => (
            <article class="series-card">
              <h3 class="series-name">{s.name}<span class="series-fa">{s.fa}</span></h3>
              <span class="series-tech">{s.tech}</span>
              <p class="series-tag">{s.tagline}</p>
              <p class="series-desc">{s.desc}</p>
              <div class="series-foot">
                {s.power !== '—'
                  ? <span class="series-power">{s.power}<i>W</i></span>
                  : <span class="series-power" style="color:var(--faint)">بنا به سفارش</span>}
                <span class:list={['series-stock', !s.stocked && 'no']}>
                  {s.stocked ? 'موجود در ایران' : 'سفارش‌پذیر'}
                </span>
              </div>
            </article>
          ))}
        </div>

        <!-- یک صفحه برای هر مدل موجود — جواب جست‌وجوهای توان‌دار -->
        <div class="dl-list ae-shop">
          {aeModels.map((m) => (
            <a class="dl-row" href={`/ae-solar/${m.slug}`}>
              <span class="dl-name">پنل {fa(m.maxW)} وات AE Solar<span>{m.series} {m.code} · موجود در انبار</span></span>
              <span class="dl-spec">{fa(m.minW)} – {fa(m.maxW)} W</span>
              <span class="dl-spec">{m.bifacial ? 'TOPCon · Bifacial' : 'PERC'}</span>
              <span class="dl-go">مشخصات کامل ←</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== راهنمای انتخاب ===== -->
    <section class="ae-sec">
      <div class="wrap">
        <header class="ae-head">
          <p class="ae-kicker">{c.techHead.kicker}</p>
          <h2 class="ae-h2">
            {markedParts(c.techHead.line1).map((part) => (part.marked ? <span class="red">{part.text}</span> : part.text))}<br />
            <em>{c.techHead.line2}</em>
          </h2>
          {c.techHead.sub && <p class="ae-sub">{c.techHead.sub}</p>}
        </header>

        <div class="tech-scroll">
          <table class="tech-table">
            <thead>
              <tr>
                <th>تکنولوژی</th>
                <th>مناسب برای</th>
                <th>بازده ماژول</th>
                <th>ضریب دمایی</th>
                <th>توضیح</th>
              </tr>
            </thead>
            <tbody>
              {c.techGuide.map((t) => (
                <tr>
                  <td><span class="tt-tech">{t.tech}</span><span class="tt-series">{t.series}</span></td>
                  <td><span class="tt-best">{t.best}</span></td>
                  <td><span class="tt-num">{t.eff}</span></td>
                  <td><span class="tt-num">{t.temp}</span></td>
                  <td><span class="tt-note">{t.note}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ===== گارانتی و استانداردها ===== -->
    <section class="ae-sec alt">
      <div class="wrap">
        <header class="ae-head">
          <p class="ae-kicker">{c.warrantyHead.kicker}</p>
          <h2 class="ae-h2">
            {markedParts(c.warrantyHead.line1).map((part) => (part.marked ? <span class="red">{part.text}</span> : part.text))}<br />
            <em>{c.warrantyHead.line2}</em>
          </h2>
          {c.warrantyHead.sub && <p class="ae-sub">{c.warrantyHead.sub}</p>}
        </header>

        <div class="warr-grid">
          {c.warranty.map((w) => (
            <div class="warr-card">
              <div class="warr-val">{w.value}{w.unit && <i>{w.unit}</i>}</div>
              <span class="warr-label">{w.label}</span>
              <span class="warr-note">{w.note}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== چرا از نماد نیرو ===== -->
    <section class="ae-sec">
      <div class="wrap">
        <header class="ae-head">
          <p class="ae-kicker">{c.whyHead.kicker}</p>
          <h2 class="ae-h2">
            {markedParts(c.whyHead.line1).map((part) => (part.marked ? <span class="red">{part.text}</span> : part.text))}<br />
            <em>{c.whyHead.line2}</em>
          </h2>
        </header>

        <div class="why-grid">
          {c.whyUs.map((w, i) => (
            <div class="why-card">
              <span class="why-num">{fa(String(i + 1).padStart(2, '0'))}</span>
              <h3>{w.title}</h3>
              <p>{w.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== خرید پنل ===== -->
    <section class="ae-sec alt" id="buy">
      <div class="wrap">
        <header class="ae-head">
          <p class="ae-kicker">{c.buyHead.kicker}</p>
          <h2 class="ae-h2">
            {markedParts(c.buyHead.line1).map((part) => (part.marked ? <span class="red">{part.text}</span> : part.text))}<br />
            <em>{c.buyHead.line2}</em>
          </h2>
          {c.buyHead.sub && <p class="ae-sub">{c.buyHead.sub}</p>}
        </header>

        <div class="why-grid">
          {c.buySteps.map((b, i) => (
            <div class="why-card">
              <span class="why-num">{fa(String(i + 1).padStart(2, '0'))}</span>
              <h3>{b.title}</h3>
              <p>{b.desc}</p>
            </div>
          ))}
        </div>

        {aeProducts.length > 0 && (
          <div class="dl-list ae-shop">
            {aeProducts.map((p) => (
              <a class="dl-row" href={`/shop/${p.slug}`}>
                <span class="dl-name">{p.name}<span>پنل خورشیدی AE Solar · فروشگاه نماد نیرو</span></span>
                <span class="dl-spec">{p.spec}</span>
                <span class="dl-spec">{p.specUnit}</span>
                <span class="dl-go">مشاهدهٔ محصول ←</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- ===== دیتاشیت‌ها ===== -->
    <section class="ae-sec">
      <div class="wrap">
        <header class="ae-head">
          <p class="ae-kicker">{c.datasheetsHead.kicker}</p>
          <h2 class="ae-h2">
            {markedParts(c.datasheetsHead.line1).map((part) => (part.marked ? <span class="red">{part.text}</span> : part.text))}<br />
            <em>{c.datasheetsHead.line2}</em>
          </h2>
          {c.datasheetsHead.sub && <p class="ae-sub">{c.datasheetsHead.sub}</p>}
        </header>

        <div class="dl-list">
          {c.datasheets.map((d) => (
            <a class="dl-row" href={d.file} download>
              <span class="dl-name">{d.series}<span>دیتاشیت پنل AE Solar · PDF</span></span>
              <span class="dl-spec">{d.tech}</span>
              <span class="dl-spec">{d.power} W</span>
              <span class="dl-go">دانلود ↓</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== پرسش‌های متداول ===== -->
    <section class="ae-sec alt">
      <div class="wrap">
        <header class="ae-head">
          <p class="ae-kicker">{c.faqHead.kicker}</p>
          <h2 class="ae-h2">
            {markedParts(c.faqHead.line1).map((part) => (part.marked ? <span class="red">{part.text}</span> : part.text))}<br />
            <em>{c.faqHead.line2}</em>
          </h2>
        </header>

        <div class="faq-list">
          {c.faq.map((f) => (
            <details class="faq-item">
              <summary class="faq-q">{f.q}</summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== لاک‌آپ شراکت ===== -->
    <section class="ae-sec">
      <div class="wrap">
        <div class="pact">
          <div class="pact-side">
            <img src="/assets/logo.png" alt="نماد نیرو" />
            <span class="pact-role us">{c.pact.us}</span>
          </div>
          <span class="pact-x">×</span>
          <div class="pact-side">
            <span class="pact-wordmark">AE SOLAR</span>
            <span class="pact-role them">{c.pact.them}</span>
          </div>
        </div>
      </div>
    </section>

    <RelatedArticles
      slugs={['ae-solar-panel-review', 'ae-solar-original-panel', 'how-panel-works']}
      title={c.related}
    />

    <!-- ===== دعوت به اقدام ===== -->
    <section class="cta-band">
      <div class="wrap">
        <h2>{c.cta.title}</h2>
        <p>{c.cta.text}</p>
        <a class="btn btn-solid" href={c.cta.href}>{c.cta.label}</a>
      </div>
    </section>

  </div>
</Base>
