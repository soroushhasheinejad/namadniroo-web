---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { getSiteSettings } from '../server/repos/siteSettings';
import { breadcrumbSchema } from '../utils';
import { getPageContent } from '../server/repos/pageContent';
import { contactPage } from '../data/pages';
import { seoProps } from '../server/seo/pageSeo';

/* پویا، تا متنی که در پنل عوض می‌شود بلافاصله دیده شود. خواندن از کش
   درون‌حافظه‌ای است، پس هزینه‌اش ناچیز است. */
export const prerender = false;

const [{ site }, c] = await Promise.all([getSiteSettings(), getPageContent(contactPage)]);

const info = [
  { icon: 'phone', title: c.info.phoneTitle, text: site.phone, href: site.phoneHref, dir: 'ltr' },
  { icon: 'pin', title: c.info.placeTitle, text: site.city },
  { icon: 'clock', title: c.info.hoursTitle, text: c.info.hours },
];

const pageSchema = breadcrumbSchema([{ name: 'تماس با ما', href: '/contact' }]);
const seo = await seoProps(c.seo);

---
<Base {...seo} schema={pageSchema}>
  <PageHero
    crumb="تماس با ما"
    title={c.hero.title}
    lead={c.hero.lead}
  />

  <section class="about-sec">
    <div class="wrap">
      <div class="cap-grid">
        {info.map((i) => (
          <div class="cap-card">
            <span class="cap-ic"><Icon name={i.icon} /></span>
            <h3>{i.title}</h3>
            {i.href
              ? <p><a href={i.href} dir={i.dir}>{i.text}</a></p>
              : <p>{i.text}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <QuoteForm />
</Base>
