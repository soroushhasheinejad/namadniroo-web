---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { getSiteSettings } from '../server/repos/siteSettings';
import { breadcrumbSchema } from '../utils';
import { getPageContent } from '../server/repos/pageContent';
import { contactPage } from '../data/pages';
import { seoProps } from '../server/seo/pageSeo';

/* پویا، تا متنی که در پنل عوض می‌شود بلافاصله دیده شود. خواندن از کش
   درون‌حافظه‌ای است، پس هزینه‌اش ناچیز است. */
export const prerender = false;

const [{ offices }, c] = await Promise.all([getSiteSettings(), getPageContent(contactPage)]);

const pageSchema = breadcrumbSchema([{ name: 'تماس با ما', href: '/contact' }]);
const seo = await seoProps(c.seo);

---
<Base {...seo} schema={pageSchema}>
  <PageHero
    crumb="تماس با ما"
    title={c.hero.title}
    lead={c.hero.lead}
  />

  <section class="about-sec">
    <div class="wrap">
      <div class="cap-grid">
        {offices.map((o) => (
          <div class="cap-card">
            <span class="cap-ic"><Icon name="pin" /></span>
            <h3>{o.title}</h3>
            {o.address && <p>{o.address}</p>}
            {o.phone && <p class="cap-tel"><a href={o.phoneHref} dir="ltr">{o.phone}</a></p>}
          </div>
        ))}
        <div class="cap-card">
          <span class="cap-ic"><Icon name="clock" /></span>
          <h3>{c.info.hoursTitle}</h3>
          <p>{c.info.hours}</p>
        </div>
      </div>
    </div>
  </section>

  <QuoteForm />
</Base>
