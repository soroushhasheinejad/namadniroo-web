---
import Base from '../layouts/Base.astro';
import { getSiteSettings } from '../server/repos/siteSettings';
import { getPageContent } from '../server/repos/pageContent';
import { notFoundPage } from '../data/pages';
import { recordNotFound } from '../server/repos/notFound';

/* سمت سرور رندر می‌شود تا صفحات پویا (محصول و مقاله) بتوانند در نبود
   رکورد به آن rewrite کنند — Astro اجازهٔ rewrite از صفحهٔ پویا به صفحهٔ
   از پیش ساخته‌شده را نمی‌دهد. */
export const prerender = false;

const [{ nav }, { body: c }] = await Promise.all([getSiteSettings(), getPageContent(notFoundPage)]);

/* هر ۴۰۴ ثبت می‌شود تا در «ریدایرکت‌ها و ۴۰۴» معلوم شود کدام پیوند شکسته
   واقعاً بازدید دارد. `originPathname` نشانی‌ای است که بازدیدکننده خواسته —
   صفحهٔ محصول و مقالهٔ ناموجود با rewrite به اینجا می‌رسند و
   `url.pathname` در آن حالت فقط «/404» است. */
const requested = Astro.originPathname || Astro.url.pathname;
if (requested !== '/404') recordNotFound(requested, Astro.request.headers.get('referer'));
---
<Base
  title="صفحه پیدا نشد | نماد نیرو"
  description="صفحه‌ای که دنبالش بودید پیدا نشد. از فهرست زیر به بخش موردنظرتان بروید."
  noindex={true}
>
  <section class="notfound">
    <div class="wrap">
      <p class="nf-code">۴۰۴</p>
      <h1 class="nf-title">{c.title}</h1>
      <p class="nf-lead">{c.lead}</p>

      <div class="nf-links">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </div>

      <div class="cta-actions nf-actions">
        <a class="btn btn-solid" href="/">{c.homeLabel}</a>
        <a class="btn btn-ghost" href="/contact">{c.contactLabel}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound {
    padding: 110px 0 90px;
    text-align: center;
    background-color: #0b0b0b;
    background-image:
      repeating-linear-gradient(118deg, rgba(95,131,155,.08) 0 1px, transparent 1px 30px),
      radial-gradient(120% 130% at 50% 0%, #16303f 0%, #0a0a0a 62%);
  }
  .nf-code {
    margin: 0; font-family: var(--mono); font-weight: 800;
    font-size: clamp(56px, 12vw, 120px); line-height: 1; color: var(--yellow);
  }
  .nf-title { margin: 14px 0 12px; font-weight: 800; font-size: clamp(22px, 3vw, 34px); }
  .nf-lead { margin: 0 auto 34px; max-width: 46ch; color: var(--muted); font-size: 17px; }
  .nf-links {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-bottom: 34px;
  }
  .nf-links a {
    padding: 8px 16px; border: 1px solid var(--line-2); border-radius: 999px;
    color: var(--muted); font-size: 14px; transition: color .2s, border-color .2s;
  }
  .nf-links a:hover { color: var(--yellow); border-color: var(--yellow); }
  .nf-actions { margin-top: 4px; }
</style>
