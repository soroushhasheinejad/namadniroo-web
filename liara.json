{
  "app": "namadniroo",
  "platform": "node",
  "port": 3000,
  "build": {
    "location": "iran"
  },
  "node": {
    "version": "22",
    "mirror": true
  },
  "disks": [
    {
      "name": "storage",
      "mountTo": "/data"
    }
  ],
  "envs": {
    "HOST": "0.0.0.0",
    "PORT": "3000",
    "DATABASE_PATH": "/data/namadniroo.db",
    "MEDIA_DIR": "/data/media"
  },
  "healthCheck": {
    "command": "CMD node -e \"fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
    "interval": 30,
    "timeout": 15,
    "retries": 3,
    "startPeriod": 40
  }
}
